---
import { site } from '../data/site';
interface Props {campaign?:boolean;}
const {campaign=false}=Astro.props;
const nav = [ {href:'/work/',label:'Work'}, {href:'/services/',label:'Services'}, {href:'/studio/',label:'Studio'}, {href:'/insights/',label:'Insights'} ];
---
<header class="site-header" data-header>
  <div class="nav-shell container">
    <a class="logo-link" href="/" aria-label="Ashbi Design home"><img src="/images/ashbi/logo.png" alt="Ashbi" width="200" height="71" /></a>
    {campaign ? <nav class="campaign-nav" aria-label="Campaign navigation"><a href="#campaign-project-heading">See the work</a><a class="button button-light" href={site.bookingUrl} data-track="booking_calendar_click">Book a call ↗</a></nav> : <><nav id="main-nav" class="site-nav" aria-label="Main navigation">
      {nav.map(item => <a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
      <a class="mobile-book" href={site.bookingUrl} data-track="booking_calendar_click">Book a call <span aria-hidden="true">↗</span></a>
    </nav>
    <a class="button button-light nav-book" href={site.bookingUrl} data-track="booking_calendar_click">Book a call <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav" data-menu-toggle><span></span><span></span></button></>}
  </div>
</header>

<style>.campaign-nav{display:flex;align-items:center;gap:24px}.campaign-nav>a:first-child{font-size:.78rem;font-weight:700}@media(max-width:620px){.campaign-nav{gap:12px}.campaign-nav>a:first-child{display:none}.campaign-nav .button{padding:14px 16px;font-size:.7rem}.nav-shell:has(.campaign-nav){gap:16px}}</style>
