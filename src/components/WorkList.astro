---
import ActionIcon from './ActionIcon.astro';
import WorkCarouselControls from './WorkCarouselControls.astro';
import { commerceProjects, type Project } from '../data/site';
interface Props { limit?: number; projects?: Project[]; intro?:string; }
const {limit = 4, projects = commerceProjects, intro="The brief, the decisions, and the finished work for product brands and online stores."} = Astro.props;
const list = projects.slice(0, limit);
---
<section class="section container work-feature" id="selected-work" aria-labelledby="work-heading">
  <div class="section-heading"><span class="eyebrow">SELECTED WORK</span><h2 id="work-heading">Off the shelf.<br /><em class="editorial">Into the everyday.</em></h2><p>{intro}</p></div>
  <div class="work-list" id="featured-work-carousel" data-work-carousel aria-label="Selected projects" tabindex="0">
    {list.map((project, index) => <article class="work-row reveal">
      <div class="work-photo"><a href={`/work/${project.slug}/`} aria-label={`View ${project.name} case study`}><img class:list={{'image-contain-marin':project.slug==='marin-food','image-contain-bpm':project.slug==='bpm'}} src={project.cardImage||project.image} style={`object-position:${project.cardImagePosition||'center'}`} alt={project.cardImageAlt||project.imageAlt||`${project.name} project by Ashbi`} loading="lazy" width="1200" height="800" /></a><span class="work-index">0{index + 1} / 0{list.length}</span></div>
      <div class="work-detail"><span class="eyebrow">{(project.presentationLabel||project.category).toUpperCase()}</span><h3>{project.name}</h3><p>{project.intro}</p><div class="tags">{project.services.map(tag => <span>{tag}</span>)}</div><a class="round-link" href={`/work/${project.slug}/`} aria-label={`Explore ${project.name}`}>Explore project <ActionIcon name="forward" /></a></div>
    </article>)}
  </div>
  <WorkCarouselControls target="featured-work-carousel" />
  <a class="text-link" href="/work/">See all work <ActionIcon name="forward" /></a>
</section>
