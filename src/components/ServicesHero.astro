---
// Services list hero — sec_h-services section.
// Loop image group: 2 identical .loop_img-group → seamless marquee
// (initImageLoop in animations.ts, ~20s/group leftward).
---
<section class="sec_h-services"><img data-hero-bg class="img" src="/images/h-service.avif" alt="" sizes="(max-width: 2512px) 100vw, 2512px" loading="lazy" srcset="/images/h-service-p-500.avif 500w, /images/h-service-p-800.avif 800w, /images/h-service-p-1080.avif 1080w, /images/h-service.avif 2512w">
  <div class="padding-global">
    <div class="container-large">
      <div class="her_top-wrap">
        <div data-hero-wrap class="her_top">
          <h1 hero-text class="text-5xl">Smarter strategy. <br><span class="opacity-73">Powered by AI.</span></h1>
          <div class="spacer-xsmall"></div>
          <div class="max-width-medium">
            <div hero-text class="text-base text-color-on-primary">From strategy to implementation, we create solutions that deliver measurable impact.</div>
          </div>
          <div class="spacer-huge"></div>
          <div class="button_wrapper">
            <a data-hero-button href="https://temlis.com" class="button-arrow w-inline-block">
              <div class="button-arrow_wrap">
                <div class="button-arrow_text">
                  <div class="text_button">Get Started</div>
                </div>
                <div class="button_container-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 20 20" fill="none" class="icon-1x1-main">
                    <path d="M13.0457 8.13128L5.8733 15.3037L4.69479 14.1252L11.8672 6.95277L5.54568 6.95277L5.54568 5.28636H14.7121V14.4528L13.0457 14.4528V8.13128Z" fill="currentColor"></path>
                  </svg></div>
                <div class="button-arrow_bg"></div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="loop_img">
    <div class="loop_img-group"><img src="/images/card-4.avif" loading="lazy" alt="" class="loop_img-card"><img src="/images/card-6.avif" loading="lazy" sizes="(max-width: 880px) 100vw, 880px" srcset="/images/card-6-p-500.avif 500w, /images/card-6.avif 880w" alt="" class="loop_img-card"><img src="/images/card-1.avif" loading="lazy" alt="" class="loop_img-card"><img src="/images/card-8.avif" loading="lazy" alt="" class="loop_img-card"><img src="/images/card-5.avif" loading="lazy" sizes="(max-width: 880px) 100vw, 880px" srcset="/images/card-5-p-500.avif 500w, /images/card-5.avif 880w" alt="" class="loop_img-card"></div>
    <div class="loop_img-group"><img src="/images/card-4.avif" loading="lazy" alt="" class="loop_img-card"><img src="/images/card-6.avif" loading="lazy" sizes="(max-width: 880px) 100vw, 880px" srcset="/images/card-6-p-500.avif 500w, /images/card-6.avif 880w" alt="" class="loop_img-card"><img src="/images/card-1.avif" loading="lazy" alt="" class="loop_img-card"><img src="/images/card-8.avif" loading="lazy" alt="" class="loop_img-card"><img src="/images/card-5.avif" loading="lazy" sizes="(max-width: 880px) 100vw, 880px" srcset="/images/card-5-p-500.avif 500w, /images/card-5.avif 880w" alt="" class="loop_img-card"></div>
  </div>
</section>
