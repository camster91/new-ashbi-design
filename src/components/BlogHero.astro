---
import { getCollection } from "astro:content";

const articles = await getCollection("articles");
const featured = articles[0];
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<section class="sec_h-blog">
  <div class="padding-section-medium"></div>
  <div class="padding-global">
    <div class="container-large">
      <div>
        <div data-hero-fade>
          <div class="tag">
            <div class="dot-square"></div>
            <div>Blog and Articles</div>
          </div>
        </div>
        <div class="spacer-large"></div>
        <h1 data-hero-fade class="h2 text-color-primary scroll-right">Latest insights and trends</h1>
        <div class="spacer-large"></div>
        <div data-hero-fade class="max-width-small is-29rem">
          <div class="text-base text-color-secondary scroll-right">Whether you’re optimizing today or building for tomorrow  we help you move faster with confidence.</div>
        </div>
      </div>
      <div class="spacer-section-small"></div>
      <div>
        <div role="list" class="w-dyn-items">
          {featured && (
            <div role="listitem" data-hero-fade class="blog_main-card w-dyn-item">
              <div class="blog_main-card_img"><img src={featured.data.thumbnail} loading="lazy" alt="" class="img"></div>
              <div class="blog_main-card_content">
                <div class="text-base text-color-secondary">{fmtDate(featured.data.date)}</div>
                <div class="max-width-small is-25rem">
                  <div class="text-3xl">{featured.data.name}</div>
                </div>
                <div class="text-base text-color-secondary">{featured.data.summary}</div>
                <div class="button_wrapper">
                  <a href={`/blog/${featured.id}`} class="button-arrow is-black w-inline-block">
                    <div class="button-arrow_wrap">
                      <div class="button-arrow_text">
                        <div class="text_button">Learn more</div>
                      </div>
                      <div class="button_container-arrow is-black"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 20 20" fill="none" class="icon-1x1-main">
                          <path d="M13.0457 8.13128L5.8733 15.3037L4.69479 14.1252L11.8672 6.95277L5.54568 6.95277L5.54568 5.28636H14.7121V14.4528L13.0457 14.4528V8.13128Z" fill="currentColor"></path>
                        </svg></div>
                      <div class="button-arrow_bg is-black"></div>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
  <div class="padding-section-medium"></div>
</section>
