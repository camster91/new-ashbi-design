---
import type {Project} from '../data/site';
import {projects,commerceProjects} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCta from './BookingCta.astro';
import ProjectGallery from './ProjectGallery.astro';
import QuoteGrid from './QuoteGrid.astro';
import {projectExtensions} from '../data/project-extensions';
interface Props {project:Project;}
const {project}=Astro.props;
const related=commerceProjects.filter(p=>p.slug!==project.slug).sort((a,b)=>b.categories.filter(c=>project.categories.includes(c)).length-a.categories.filter(c=>project.categories.includes(c)).length).slice(0,2);
const socialImage=projects.slice(0,4).some(p=>p.slug===project.slug)?`/images/ashbi/${project.slug}-og.webp`:project.image;
const extensions=projectExtensions[project.slug] || [];
---
<BaseLayout title={`${project.name} | Ashbi Design Work`} description={project.intro} image={socialImage} canonicalPath={`/work/${project.slug}/`} noindex={!commerceProjects.some(p=>p.slug===project.slug)}>
<main id="main" data-project-view={project.slug}>
  <section class:list={['interior-hero','container','project-hero',{'project-hero--wide':project.slug==='bpm'}]}><div><span class="eyebrow">SELECTED WORK / {project.categories.join(' · ')}</span><h1>{project.name}<em>.</em></h1><p>{project.intro}</p><div class="tags">{project.services.map(t=><span>{t}</span>)}</div></div><img src={project.image} alt={`${project.name} work by Ashbi Design`} width="1400" height="900" fetchpriority="high" /></section>
  <section class="section container case-story"><div><span class="eyebrow">THE CONTEXT</span><h2>The idea behind <em>the work.</em></h2></div><div><p>{project.context||project.intro}</p><dl class="project-facts">{project.client&&<div><dt>Client</dt><dd>{project.client}</dd></div>}{project.year&&<div><dt>Year</dt><dd>{project.year}</dd></div>}<div><dt>Ashbi’s role</dt><dd>{project.services.join(' · ')}</dd></div></dl></div></section>
  {project.gallery.length>1&&<ProjectGallery images={project.gallery} name={project.name} />}
  <section class="section container case-story"><div><span class="eyebrow">THE APPROACH</span><h2>Every detail, <em>part of the story.</em></h2></div><div><p>{project.approach}</p><p>{project.outcome}</p><span class="eyebrow">WHAT WE CREATED</span><ul class="deliverable-list">{project.deliverables.map(t=><li>{t}</li>)}</ul></div></section>
  {extensions.length>0&&<section id="more-applications" class="container project-extensions" aria-labelledby="project-extensions-heading"><div><span class="eyebrow">MORE APPLICATIONS</span><h2 id="project-extensions-heading">See the work <em>in other formats.</em></h2><p>Explore more examples shared by Ashbi on Dribbble.</p></div><div class="project-extension-grid">{extensions.map(item=><a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} ${item.label} on Dribbble (opens in a new tab)`}><span class="eyebrow">{item.format}</span><strong>{item.label}</strong><span aria-hidden="true">↗</span></a>)}</div></section>}
  {project.testimonialId&&<section class="container case-quote" aria-label="Client feedback"><QuoteGrid ids={[project.testimonialId]} /></section>}
  <section class="section container"><div class="section-heading"><span class="eyebrow">KEEP EXPLORING</span><h2>More work from <em>the studio.</em></h2></div><div class="project-grid">{related.map(p=><a class="project-tile" href={`/work/${p.slug}/`}><img src={p.cardImage||p.image} alt="" loading="lazy" width="800" height="560" /><span>{p.categories.join(' · ')}</span><h3>{p.name} ↗</h3></a>)}</div><a class="text-link" href="/work/">All work ↗</a></section>
  <BookingCta service={project.category==='Websites'?'web-design':project.category==='Packaging'?'packaging-design-services':'branding'} />
</main></BaseLayout>
