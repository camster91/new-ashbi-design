---
import WorkCarouselControls from './WorkCarouselControls.astro';
import type {Project} from '../data/site';
import {projects,commerceProjects,services} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCta from './BookingCta.astro';
import ProjectGallery from './ProjectGallery.astro';
import QuoteGrid from './QuoteGrid.astro';
import ProductionWorkStory from './ProductionWorkStory.astro';
import {projectExtensions} from '../data/project-extensions';
import {relatedProjectSlugs} from '../data/content-links';
interface Props {project:Project;}
const {project}=Astro.props;
const isProductionWork=project.slug==='production-work';
const related=(relatedProjectSlugs[project.slug]||[]).map(slug=>commerceProjects.find(p=>p.slug===slug)).filter((p):p is Project=>Boolean(p));
const socialImage=projects.slice(0,4).some(p=>p.slug===project.slug)?`/images/ashbi/${project.slug}-og.webp`:project.image;
const extensions=projectExtensions[project.slug] || [];
const enquiryService=['della','production-work'].includes(project.slug)?'design-and-dev-subscription':project.category==='Websites'?'web-design':project.category==='Packaging'?'packaging-design-services':'branding';
const relatedService=services.find(service=>service.slug===enquiryService)!;
const projectReference=commerceProjects.some(item=>item.slug===project.slug)?project.slug:'';
const briefParams=new URLSearchParams({service:enquiryService});
if(projectReference)briefParams.set('project',projectReference);
const briefHref=`/contact/?${briefParams}#project-brief`;
---
<BaseLayout title={`${project.name} | Ashbi Design Work`} description={project.intro} image={socialImage} canonicalPath={`/work/${project.slug}/`} noindex={!commerceProjects.some(p=>p.slug===project.slug)}>
<main id="main" data-project-view={project.slug}>
  <section class:list={['interior-hero','container','project-hero',{'project-hero--wide':['bpm','ancient-bliss'].includes(project.slug),'project-hero--production':isProductionWork}]}><div><span class="eyebrow">SELECTED WORK / {isProductionWork?'CREATIVE PRODUCTION':project.presentationLabel||project.categories.join(' · ')}</span><h1>{project.name}<em>.</em></h1><p>{project.intro}</p><div class="tags">{project.services.map(t=><span>{t}</span>)}</div>{isProductionWork&&<a class="case-service-link production-full-image" href={project.image} target="_blank" rel="noopener noreferrer">View the full Kalm sticker sheet ↗</a>}{project.visualSource&&<p class="project-image-source">{project.visualSource.note} <a href={project.visualSource.url}>View {project.visualSource.label} ↗</a>{project.visualSource.creditSource&&<> · <a href={project.visualSource.creditSource.url}>Read {project.visualSource.creditSource.label} ↗</a></>}</p>}</div><img src={project.image} style={`object-position:${project.imagePosition||project.cardImagePosition||'center'}`} alt={project.imageAlt||`${project.name} work by Ashbi Design`} width={isProductionWork?1200:1400} height={isProductionWork?637:900} fetchpriority="high" /></section>
  <section class="section container case-story"><div><span class="eyebrow">THE CONTEXT</span><h2>{isProductionWork?<>Two briefs. <em>Two formats.</em></>:<>The idea behind <em>the work.</em></>}</h2></div><div><p>{project.context||project.intro}</p><dl class="project-facts">{project.client&&<div><dt>Client</dt><dd>{project.client}</dd></div>}{project.year&&<div><dt>Year</dt><dd>{project.year}</dd></div>}<div><dt>Ashbi’s role</dt><dd>{project.services.join(' · ')}</dd></div></dl><div class="case-next-actions"><a class="text-link" href={briefHref}>Discuss a similar project ↗</a><a class="case-service-link" href={`/services/${relatedService.slug}/`}>Explore {relatedService.name.toLowerCase()} ↗</a></div></div></section>
  {isProductionWork?<ProductionWorkStory />:<>{project.gallery.length>1&&<ProjectGallery images={project.gallery} name={project.name} />}<section class="section container case-story"><div><span class="eyebrow">THE APPROACH</span><h2>Every detail, <em>part of the story.</em></h2></div><div><p>{project.approach}</p><p>{project.outcome}</p><span class="eyebrow">WHAT WE CREATED</span><ul class="deliverable-list">{project.deliverables.map(t=><li>{t}</li>)}</ul></div></section></>}
  {extensions.length>0&&<section id="more-applications" class="container project-extensions" aria-labelledby="project-extensions-heading"><div><span class="eyebrow">MORE APPLICATIONS</span><h2 id="project-extensions-heading">See the work <em>in other formats.</em></h2><p>Explore more examples shared by Ashbi on Dribbble.</p></div><div class="project-extension-grid">{extensions.map(item=><a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} ${item.label} on Dribbble (opens in a new tab)`}><span class="eyebrow">{item.format}</span><strong>{item.label}</strong><span aria-hidden="true">↗</span></a>)}</div></section>}
  {project.testimonialId&&<section class="container case-quote" aria-label="Client feedback"><QuoteGrid ids={[project.testimonialId]} /></section>}
  <section class="section container"><div class="section-heading"><span class="eyebrow">KEEP EXPLORING</span><h2>More work from <em>the studio.</em></h2></div><div class="project-grid" id="related-work-carousel" data-work-carousel aria-label="Related projects" tabindex="0">{related.map(p=><a class="project-tile" href={`/work/${p.slug}/`}><img class:list={{'image-contain-marin':p.slug==='marin-food','image-contain-bpm':p.slug==='bpm'}} src={p.cardImage||p.image} style={`object-position:${p.cardImagePosition||'center'}`} alt="" loading="lazy" width="800" height="560" /><span>{p.presentationLabel||p.categories.join(' · ')}</span><h3>{p.name} ↗</h3></a>)}</div><WorkCarouselControls target="related-work-carousel" /><a class="text-link" href="/work/">All work ↗</a></section>
  <BookingCta service={enquiryService} project={projectReference} />
</main></BaseLayout>

<style>.case-next-actions{display:flex;flex-direction:column;align-items:flex-start;gap:18px}.case-service-link{font-size:.86rem;text-decoration:underline;text-underline-offset:4px}.project-hero--production img{height:auto;aspect-ratio:1200/637;object-fit:contain}.production-full-image{display:inline-block;margin-top:22px}.project-hero--production+.case-story{padding-top:clamp(28px,4vw,60px)}</style>
