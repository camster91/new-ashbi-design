<section data-anim="hero" class="section_hero">
  <div data-hero-wrap class="hero_wrap">
    <div class="padding-global is-hero">
      <div class="vertical-center">
        <h1 hero-text class="text-align-center">Building the future with <br><span class="opacity-73">AI and strategy</span></h1>
        <div class="spacer-medium"></div>
        <div class="max-width-medium">
          <div hero-text class="text-base text-color-on-primary text-align-center">We help organizations unlock growth and efficiency through data-driven consulting and intelligent automation.</div>
        </div>
        <div class="spacer-huge"></div>
        <div class="button_wrapper is-hero">
          <div data-hero-button>
            <a href="https://temlis.com" class="button w-variant-3876fb3c-f589-169e-8f41-073b5a3f3902 w-inline-block">
              <div class="text-button-wrap">
                <div>View Demo</div>
              </div>
            </a>
          </div>
          <a href="https://temlis.com" data-hero-button class="button-arrow w-inline-block">
            <div class="button-arrow_wrap">
              <div class="button-arrow_text">
                <div class="text_button">Get Started</div>
              </div>
              <div class="button_container-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 20 20" fill="none" class="icon-1x1-main">
                  <path d="M13.0457 8.13128L5.8733 15.3037L4.69479 14.1252L11.8672 6.95277L5.54568 6.95277L5.54568 5.28636H14.7121V14.4528L13.0457 14.4528V8.13128Z" fill="currentColor"></path>
                </svg></div>
              <div class="button-arrow_bg"></div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="spacer">
    <div style="height: 4rem" class="spacer-desktop"></div>
    <div style="height: 5rem" class="spacer-tablet"></div>
    <div style="height: 5rem" class="spacer-mobile"></div>
  </div>
  <div data-hero-visual class="_3d">
    <div class="wrap">
      <div class="group first">
        <div class="img3d"><img src="/images/card.avif" loading="lazy" alt="" class="image3d"></div>
