---
// Services testimonials — sec_testi-services section.
// testi_loop: 2 identical card-groups → seamless marquee
// via initLoops() in animations.ts (max-content track, xPercent -50, ~80px/s left).
const quoteIcon = "M3.33203 6.66797H14.6654V16.868L8.68936 25.3346H5.0587L8.61336 17.3346H3.33203V6.66797ZM17.332 6.66797H28.6654V16.868L22.6894 25.3346H19.0587L22.6134 17.3346H17.332V6.66797Z";

const cards = [
  { img: "/images/testimonials-img-1.avif", imgClass: "testi-service_card_img", sizes: "100vw", srcset: "/images/testimonials-img-1-p-500.avif 500w, /images/testimonials-img-1.avif 752w", quote: "&quot;They brought clarity to complex problems, breaking down barriers and delivering innovative solutions.”" },
  { img: "/images/testi-card-2.avif", imgClass: "testi-service_card_img is-sm", sizes: "(max-width: 1112px) 100vw, 1112px", srcset: "/images/testi-card-2-p-500.avif 500w, /images/testi-card-2-p-800.avif 800w, /images/testi-card-2.avif 1112w", quote: "&quot;Their insight resolved difficult hurdles, opening new paths and creating highly effective strategies.&quot;" },
  { img: "/images/testi-card-3.avif", imgClass: "testi-service_card_img", sizes: "(max-width: 1112px) 100vw, 1112px", srcset: "/images/testi-card-3-p-500.avif 500w, /images/testi-card-3.avif 1112w", quote: "&quot;We found focus for tricky requirements, cutting through noise and providing truly advanced responses.&quot;" },
  { img: "/images/testi-card-4.avif", imgClass: "testi-service_card_img is-sm", sizes: "(max-width: 1112px) 100vw, 1112px", srcset: "/images/testi-card-4-p-500.avif 500w, /images/testi-card-4.avif 1112w", quote: "&quot;They gave simple paths to hard puzzles, removing all delays while building fresh, brilliant projects.&quot;" },
];
---
<section class="sec_testi-services">
  <div class="padding-section-medium"></div>
  <div class="padding-global">
    <div class="container-large">
      <div data-reveal>
        <div data-wf--tag-section--variant="base" class="tag">
          <div class="dot-square"></div>
          <div>Testimonials</div>
        </div>
        <div class="spacer-large"></div>
        <h2 class="scroll-right">What they say about us?</h2>
        <div class="spacer-large"></div>
        <div class="text-base text-color-secondary scroll-right">Here’s what they shared about their experience working with our team.</div>
      </div>
      <div class="spacer-section-medium"></div>
      <div class="testi_loop">
        {[0, 1].map(() => (
          <div class="testi-services_cards">
            {cards.map((c) => (
              <div class="testi-service_card">
                <div class={c.imgClass}><img src={c.img} loading="lazy" sizes={c.sizes} srcset={c.srcset} alt="" class="img"></div>
                <div class="testi-service_card_content"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 32 32" fill="none" class="icon-1x1-large">
                    <path d={quoteIcon} fill="currentColor"></path>
                  </svg>
                  <div class="spacer-xsmall"></div>
                  <div class="text-lg text-style-3lines" set:html={c.quote}></div>
                  <div class="spacer-large"></div>
                  <div class="text-base text-align-right">- John Doe Tech Innovations </div>
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="padding-section-medium"></div>
</section>
