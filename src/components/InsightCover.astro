---
interface Props {title:string;category:string;slug:string;}
const {title,category,slug}=Astro.props;
const variant=['prepare-for-a-shopify-redesign','10-principles-of-good-web-design'].includes(slug)?'web':slug==='packaging-design-project-checklist'?'pack':slug==='what-a-creative-partnership-can-handle'?'partner':'brand';
---
<div class:list={['editorial-cover',`editorial-cover-${variant}`]}>
 <span class="cover-category">{category}</span><b>{title}</b>
 <div class="cover-diagram" aria-hidden="true">
  {variant==='web'?<><i class="cover-browser"><span></span><span></span><span></span></i><i class="cover-phone"></i></>:variant==='pack'?<><i class="cover-pack"></i><i class="cover-pack cover-pack-small"></i></>:variant==='partner'?<><i class="cover-sheet"></i><i class="cover-sheet"></i><i class="cover-sheet"></i><span class="cover-arrow">↗</span></>:<><i class="cover-ring"></i><span class="cover-star">✳</span></>}
 </div><span class="cover-signoff" aria-hidden="true">ASHBI / STUDIO NOTES</span>
</div>
<style>
 .editorial-cover{position:relative;min-height:330px;padding:25px;overflow:hidden;border-radius:8px;background:#d8ffc2;color:#2b2e52;display:flex;flex-direction:column;isolation:isolate}
 .cover-category,.cover-signoff{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;font-weight:700}
 .editorial-cover b{font-family:Georgia,serif;font-style:italic;font-weight:400;font-size:clamp(2.2rem,3vw,3.3rem);line-height:1.08;letter-spacing:-.045em;max-width:85%;margin-top:26px;position:relative;z-index:1}
 .cover-signoff{margin-top:auto;padding-top:22px}
 .editorial-cover-web{background:#d2deea}.editorial-cover-pack{background:#e6f254}.editorial-cover-partner{background:#42467d;color:#fffdf4}
 .cover-diagram{position:relative;align-self:flex-end;margin-top:24px;width:180px;height:110px;flex-shrink:0;z-index:0}.cover-diagram i{display:block;position:absolute;border:2px solid currentColor;background:transparent}
 .cover-browser{width:160px;height:90px;left:0;top:0;border-radius:4px}.cover-browser:before{content:'';display:block;height:16px;border-bottom:2px solid currentColor}.cover-browser span{display:inline-block;width:31px;height:36px;margin:12px 4px 0 10px;border:1px solid currentColor}.cover-phone{width:40px;height:74px;right:-5px;bottom:-7px;background:#fffdf4!important;border-radius:6px}
 .cover-pack{width:85px;height:100px;left:22px;top:0;transform:skewY(-8deg);box-shadow:12px 0 0 #2b2e5220}.cover-pack:before{content:'';position:absolute;inset:18px 12px;border-top:8px solid currentColor;border-bottom:2px solid currentColor}.cover-pack-small{width:52px;height:66px;left:118px;top:40px}
 .cover-sheet{width:76px;height:94px;top:8px;left:12px;transform:rotate(-9deg)}.cover-sheet:after{content:'';position:absolute;inset:20px 12px;border-top:2px solid currentColor;border-bottom:2px solid currentColor}.cover-sheet:nth-child(2){left:43px;top:0;transform:rotate(2deg)}.cover-sheet:nth-child(3){left:74px;top:12px;transform:rotate(12deg)}.cover-arrow{position:absolute;right:0;bottom:-10px;font-size:70px;line-height:1;color:#e6f254}
 .cover-ring{width:105px;height:105px;border-radius:50%;right:30px;top:0}.cover-star{position:absolute;right:0;bottom:-20px;font-size:100px;line-height:1}
 @media(max-width:760px){.editorial-cover{min-height:300px}.editorial-cover b{font-size:2.6rem;max-width:90%}}
</style>
