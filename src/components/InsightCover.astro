---
interface Props {title:string;category:string;slug:string;}
const {title,category,slug}=Astro.props;
const artwork:Record<string,[string,string]>={
 'prepare-for-a-shopify-redesign':['shopify','Paper cards arranged into a website plan on a studio table'],
 'what-a-creative-partnership-can-handle':['partner','Two people passing an indigo sketchbook across a studio table'],
 'packaging-design-project-checklist':['packaging','An unfolded packaging dieline beside a finished indigo carton'],
 'brand-refresh-or-rebrand':['refresh','Two related flowers made from indigo and lime paper'],
 '10-principles-of-good-web-design':['web','Wooden shapes arranged into a clear visual path'],
 'mastering-illustration-styles-in-graphic-design-a-comprehensive-guide':['illustration','A pear explored in charcoal, paper collage and gouache'],
};
const cover=artwork[slug];
---
<div class="editorial-cover">
 {cover?<img src={`/images/ashbi/editorial/${cover[0]}-v1.webp`} alt={cover[1]} width="900" height="675" loading="lazy" decoding="async" />:<div class="cover-fallback"><span>{category}</span><b>{title}</b></div>}
 <span class="cover-caption">{title}</span>
</div>
<style>
.editorial-cover{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;border-radius:8px;background:#f5f0e6;flex:none}
.cover-caption{position:absolute;bottom:12px;left:12px;max-width:calc(100% - 24px);background:#fffdf4eb;color:#2b2e52;padding:7px 10px;border-radius:4px;font-size:.75rem;line-height:1.3;font-weight:600}
.editorial-cover img{display:block;width:100%;height:100%;object-fit:cover}
.cover-fallback{height:100%;padding:24px;display:flex;flex-direction:column;justify-content:space-between;background:#d2deea;color:#2b2e52}
.cover-fallback span{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em}
.cover-fallback b{font-family:Georgia,serif;font-size:clamp(1.6rem,2.8vw,2.7rem);line-height:1.1;font-style:italic;font-weight:400}
</style>
