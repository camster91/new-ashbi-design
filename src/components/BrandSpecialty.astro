---
import ActionIcon from './ActionIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {site,projects} from '../data/site';
interface Props {workshop?:boolean;}
const {workshop=false}=Astro.props;
const title=workshop?'Brand strategy workshop':'Brand identity design';
const summary=workshop?'Make the important brand decisions before designing the next thing. A focused workshop helps your team agree on audience, positioning and creative priorities.':'Turn an agreed direction into a visual identity your team can use across packaging, websites and everyday communications.';
const steps=workshop?[
 {title:'Bring the business context',copy:'Share your offer, audience, existing research and the decisions holding the team up. Identify the people who need to contribute and approve the direction.'},
 {title:'Work through the choices',copy:'Explore audience needs, competitive context, positioning and the message your brand needs to communicate. Surface disagreements so they can become clear decisions.'},
 {title:'Define the next brief',copy:'Document the agreed direction, open questions and priorities for design. Confirm the workshop format and outputs in the scope before booking.'}
]:[
 {title:'Start with a direction',copy:'Use your existing strategy or agree a discovery phase. Clarify what the identity should communicate and where it needs to work.'},
 {title:'Build the visual language',copy:'Explore logo, typography, colour and graphic elements together. Review the system in relevant applications rather than judging the mark in isolation.'},
 {title:'Prepare it for your team',copy:'Refine the selected direction, prepare agreed files and document practical usage guidance. Scope packaging, website builds and other rollout work explicitly.'}
];
const project=projects.find(p=>p.slug==='cocofro')!;
---
<BaseLayout title={`${title} | Ashbi Design`} description={summary}>
<main id="main">
<section class="interior-hero container"><span class="eyebrow">{workshop?'BEFORE DESIGN BEGINS':'FROM DIRECTION TO APPLICATION'}</span><h1>{title}<em>.</em></h1><p>{summary}</p><a class="button button-lime" href={site.bookingUrl} data-track="booking_calendar_click">Book a call <ActionIcon name="external" /></a></section>
<section class="section container specialty-scope"><div><span class="eyebrow">IS THIS THE RIGHT START?</span><h2>{workshop?'Get the team aligned.':'Give the brand a consistent presence.'}</h2><p>{workshop?'Useful when your team is unsure who the brand is for, what makes it different or what a refresh should change. Bring those questions before commissioning a new identity.':'Useful when your positioning is clear but your visual presentation is inconsistent, hard to apply or no longer fits the business.'}</p><p>{workshop?'This is a strategy engagement. Identity design, packaging and website implementation can follow under a separate agreed scope.':'If the underlying positioning is still unsettled, start with a strategy conversation before choosing visual directions.'}</p></div><ol>{steps.map(step=><li><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol></section>
{!workshop&&<section class="section container specialty-proof"><img src={project.cardImage||project.image} alt="CocoFro identity applied across its product packaging" loading="lazy" width="1200" height="900"/><div><span class="eyebrow">IDENTITY IN USE</span><h2>A family of packs.<br/>One recognisable brand.</h2><p>CocoFro combines expressive type with flavour-specific colour. See how the identity carries across the range.</p><a class="text-link" href="/work/cocofro/">Explore CocoFro <ActionIcon name="forward" /></a></div></section>}
<section class="section container specialty-close"><h2>Choose the right starting point.</h2><p>Tell us what has changed, what you already have and which decisions you need help making. We’ll discuss scope and next steps.</p><div><a class="button button-lime" href="/contact/?service=branding#project-brief">Send a branding brief <ActionIcon name="forward" /></a><a class="text-link" href="/services/branding/">All branding services <ActionIcon name="forward" /></a></div></section>
</main></BaseLayout>
<style>.interior-hero{padding-block:64px 32px}.interior-hero p{max-width:800px}.section{padding-block:64px}.specialty-scope,.specialty-proof{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,6vw,90px);align-items:start}.specialty-scope ol{padding-left:24px;margin:0}.specialty-scope li{padding:0 0 24px 12px}.specialty-scope h3{font-size:1.65rem}.specialty-scope p,.specialty-proof p{color:var(--muted)}.specialty-proof img{border-radius:24px;width:100%;height:auto}.specialty-close{border-top:1px solid var(--line)}.specialty-close p{max-width:760px}.specialty-close>div{display:flex;align-items:center;flex-wrap:wrap;gap:24px}@media(max-width:760px){.specialty-scope,.specialty-proof{grid-template-columns:1fr}.interior-hero{padding-block:36px 24px}.section{padding-block:40px}.interior-hero h1{font-size:3rem}}</style>
