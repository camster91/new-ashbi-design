---
import {services} from '../data/site';

const visuals=[
  {src:'/images/ashbi/gallery/cocofro-03-1800.webp',client:'CocoFro',alt:'CocoFro typography and colour system'},
  {src:'/images/ashbi/clypse-main.webp',client:'Clypse Beauty',alt:'Clypse Beauty website composition'},
  {src:'/images/ashbi/gallery/cocofro-14-1200.webp',client:'CocoFro',alt:'CocoFro packaging range'},
  {src:'/images/ashbi/gallery/waagbag-01-1200.webp',client:'WaagBag',alt:'WaagBag creative assets for social channels'},
];
---
<section class="section services-showcase" aria-labelledby="services-heading">
  <div class="container">
    <div class="showcase-intro reveal">
      <div><span class="eyebrow">WHAT WE CAN CREATE / 03</span><h2 id="services-heading">The right pieces, <em>working together.</em></h2></div>
      <p>Start with a brand, a website, a pack, or the work that follows. We shape each piece for the way people meet your business, then make it feel part of the same story.</p>
    </div>
    <div class="showcase-layout" data-services-showcase>
      <div class="showcase-visual" aria-hidden="true">
        {visuals.map((visual,index)=><div class:list={['showcase-visual-layer',{'is-active':index===0}]} data-service-visual><img src={visual.src} alt="" width="1200" height="900" loading={index===0?'eager':'lazy'} /><div class="showcase-visual-caption"><span>ASHBI WORK / {visual.client}</span><span>0{index+1} / 04</span></div></div>)}
      </div>
      <ol class="service-story-list">
        {services.map((service,index)=><li class:list={['service-story',{'is-active':index===0}]} data-service-step>
          <span class="service-story-number">0{index+1} / 04</span>
          <img class="service-story-image" src={visuals[index].src} alt={visuals[index].alt} width="900" height="675" loading="lazy" />
          <div class="service-story-copy"><span class="eyebrow">{service.eyebrow} · {visuals[index].client}</span><h3>{service.name}</h3><p>{service.summary}</p><p class="service-story-fit">{service.fit}</p><ul aria-label="What this can include">{service.details.map(detail=><li>{detail}</li>)}</ul><a href={`/services/${service.slug}/`}>Explore this service <span aria-hidden="true">↗</span></a></div>
        </li>)}
      </ol>
    </div>
    <div class="showcase-next"><span>Not sure where to begin?</span><a href="/contact/">Tell us what you’re building <span aria-hidden="true">↗</span></a></div>
  </div>
</section>

<style>
  .services-showcase{background:#f0f3f3;overflow:clip;padding-bottom:64px}
  .showcase-intro{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);align-items:end;gap:clamp(30px,7vw,100px);margin-bottom:clamp(46px,6vw,82px)}
  .showcase-intro h2{margin:0;max-width:920px}
  .showcase-intro p{margin:0 0 8px;color:var(--muted);font-size:clamp(1rem,1.3vw,1.17rem)}
  .showcase-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.9fr);gap:clamp(34px,6vw,100px);align-items:start}
  .showcase-visual{position:sticky;top:112px;height:min(72vh,650px);min-height:480px;border-radius:28px;overflow:hidden;background:#dfe3e6;box-shadow:0 26px 60px #2027461a}
  .showcase-visual-layer{position:absolute;inset:0;opacity:0;transform:scale(1.045);transition:opacity .55s ease,transform .9s cubic-bezier(.2,.7,.2,1);pointer-events:none}
  .showcase-visual-layer.is-active{opacity:1;transform:scale(1);z-index:1}
  .showcase-visual-layer img{width:100%;height:100%;object-fit:cover}
  .showcase-visual-caption{position:absolute;inset:auto 20px 20px;display:flex;justify-content:space-between;gap:16px;padding:13px 16px;border-radius:12px;background:#f7f8f1ec;backdrop-filter:blur(10px);font-size:.65rem;font-weight:800;letter-spacing:.12em}
  .service-story-list{list-style:none;padding:0;margin:0;display:grid;gap:20px}
  .service-story{min-height:360px;padding:clamp(28px,3.5vw,48px);border:1px solid var(--line);border-radius:24px;background:#fff;transition:border-color .3s,box-shadow .3s,transform .3s}
  .service-story.is-active{border-color:#929aca;box-shadow:0 20px 48px #20274614;transform:translateX(-6px)}
  .service-story-number{display:block;margin-bottom:36px;font-size:.72rem;font-weight:800;letter-spacing:.15em;color:#737ca5}
  .service-story .eyebrow{font-size:.63rem;margin-bottom:16px;color:#727ba0}
  .service-story h3{font-size:clamp(2rem,3vw,3.25rem);margin:0 0 17px}
  .service-story p{margin:0 0 13px;font-size:1rem;line-height:1.55}
  .service-story .service-story-fit{font-size:.9rem;color:var(--muted)}
  .service-story ul{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:22px 0 27px;padding:0}
  .service-story ul li{padding:7px 11px;border:1px solid var(--line);border-radius:100px;font-size:.69rem;font-weight:700;line-height:1.3}
  .service-story a{display:inline-flex;gap:20px;align-items:center;border-bottom:1px solid currentColor;padding-bottom:6px;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em}
  .service-story a:hover{gap:27px}
  .service-story-image{display:none}
  .showcase-next{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:40px;padding-top:25px;border-top:1px solid var(--line);font-size:.85rem}
  .showcase-next a{font-weight:800;text-transform:uppercase;letter-spacing:.07em;border-bottom:1px solid currentColor;padding-bottom:7px}
  @media(max-width:900px){
    .showcase-intro{grid-template-columns:1fr;gap:20px}.showcase-intro p{max-width:700px}
    .showcase-layout{grid-template-columns:1fr}.showcase-visual{display:none}
    .service-story-list{grid-template-columns:repeat(2,minmax(0,1fr))}
    .service-story{min-height:0;padding:20px;transform:none!important}
    .service-story-image{display:block;width:100%;height:clamp(190px,25vw,250px);object-fit:cover;border-radius:15px;margin-bottom:24px}
    .service-story-number{margin-bottom:18px}.service-story h3{font-size:clamp(1.7rem,3.8vw,2.4rem)}
  }
  @media(max-width:620px){.services-showcase{padding-bottom:54px}.service-story-list{grid-template-columns:1fr}.service-story{padding:18px}.service-story h3{font-size:2rem}.service-story-image{height:190px}.showcase-next{align-items:flex-start;flex-direction:column}}
  @media(prefers-reduced-motion:reduce){.showcase-visual{display:none}.showcase-layout{grid-template-columns:1fr}.service-story-list{grid-template-columns:repeat(2,minmax(0,1fr))}.service-story{min-height:0;transform:none!important;transition:none}.service-story-image{display:block;width:100%;height:clamp(190px,25vw,250px);object-fit:cover;border-radius:15px;margin-bottom:24px}}
  @media(max-width:620px) and (prefers-reduced-motion:reduce){.service-story-list{grid-template-columns:1fr}}
</style>
