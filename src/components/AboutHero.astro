                    <div class="text-wrap">
                      <div class="vcard_text-amount">$</div>
                      <div fs-numbercount-duration="1500" fs-numbercount-element="number" fs-numbercount-start="0" fs-numbercount-end="4900" class="vcard_text-amount">4900</div>
                    </div>
                    <p class="vcard_text-amount-muted text-weight-medium">/ $10,000</p>
                  </div>
                </div>
                <div data-anim="progress" class="vcard_progress-bg">
                  <div class="vcard_progress-fill"></div>
                </div>
              </div>
              <div data-anim="stagger-rows" class="vcard_section-list">
