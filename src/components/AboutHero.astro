<section class="sec_h-about">
  <div class="container-full height-100">
    <div class="grid-two-col height-100">
      <div class="h-about_content">
        <div data-hero-stairs class="testi-people">
          <div>Trusted over 5,000+</div>
          <div class="avatars-wrap">
            <div class="avatar-item is-first"><img loading="lazy" src="/images/hero-icon-one_1hero-icon-one.webp" alt="" class="img"></div>
            <div class="avatar-item is-second"><img sizes="(max-width: 1128px) 100vw, 1128px, 100vw" srcset="/images/section-1_1section-1.webp 500w, /images/section-1_1section-1.webp 800w, /images/section-1_1section-1.webp 1080w, /images/section-1_1section-1.webp 1128w" alt="" src="/images/section-1_1section-1.webp" loading="lazy" class="img"></div>
            <div class="avatar-item is-third"><img loading="lazy" src="/images/hero-icon-three_1hero-icon-three.webp" alt="" class="img"></div>
          </div>
        </div>
        <div class="spacer-huge"></div>
        <div class="max-title is-33rem">
          <h1 hero-text class="text-4xl text-align-center text-color-primary">Empowering businesses through strategy and AI</h1>
        </div>
        <div class="spacer-medium"></div>
        <div class="max-text is-23rem">
          <div hero-text class="text-base text-align-center text-color-secondary">We are a consulting and AI innovation firm dedicated to helping organizations think smarter, move faster, and grow stronger.</div>
        </div>
        <div class="spacer-huge"></div>
        <a data-hero-button href="/contact" class="button-arrow is-black w-inline-block">
          <div class="button-arrow_wrap">
            <div class="button-arrow_text">
              <div class="text_button">Get Started</div>
            </div>
            <div class="button_container-arrow is-black"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 20 20" fill="none" class="icon-1x1-main">
                <path d="M13.0457 8.13128L5.8733 15.3037L4.69479 14.1252L11.8672 6.95277L5.54568 6.95277L5.54568 5.28636H14.7121V14.4528L13.0457 14.4528V8.13128Z" fill="currentColor"></path>
              </svg></div>
            <div class="button-arrow_bg is-black"></div>
          </div>
        </a>
      </div>
      <div class="h-about_img">
        <div class="visual_wrap-first">
          <div data-anim="card-reveal" class="ecard is-only">
            <div data-anim="stagger-text" class="ecard_inner">
              <p class="ecard_text">Expertise</p>
              <div class="ecard_badge"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 17 17" fill="none" class="ecard_badge-icon">
                  <rect width="16.9398" height="16.9398" rx="8.46988" fill="000"></rect>
                  <g clip-path="url(#clip0_15685_42665)">
