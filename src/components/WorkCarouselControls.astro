---
interface Props { target: string; itemLabel?: string; }
const {target,itemLabel='project'}=Astro.props;
---
<div class="work-carousel-controls" data-carousel-controls={target} hidden>
  <span data-carousel-position aria-live="polite" aria-atomic="true">Swipe to explore</span>
  <div><button type="button" data-carousel-step="-1" aria-label={`Previous ${itemLabel}`} aria-controls={target}>←</button><button type="button" data-carousel-step="1" aria-label={`Next ${itemLabel}`} aria-controls={target}>→</button></div>
</div>
