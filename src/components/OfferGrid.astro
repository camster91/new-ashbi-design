---
import ActionIcon from './ActionIcon.astro';
import {offers} from '../data/offers';
import {services} from '../data/site';
import WorkCarouselControls from './WorkCarouselControls.astro';
interface Props { compact?: boolean; headingLevel?: 2 | 3; showServices?: boolean; mobileCarousel?: boolean; }
const {compact=false,headingLevel=3,showServices=false,mobileCarousel=false}=Astro.props;
const orderedOffers=[...offers].sort((a,b)=>Number(Boolean(b.featured))-Number(Boolean(a.featured)));
---
<div class:list={['offer-grid',{'offer-grid-compact':compact}]} id={mobileCarousel?'home-services-carousel':undefined} data-work-carousel={mobileCarousel?true:undefined} role={mobileCarousel?'region':undefined} aria-label={mobileCarousel?'Services and ways to work together':undefined} tabindex={mobileCarousel?0:undefined}>
  {orderedOffers.map(offer=><article class:list={['offer-card','reveal',{'offer-card-featured':offer.featured,'offer-card-packaging':offer.serviceSlug==='packaging-design-services'}]}>
    <div class="offer-image"><img class:list={{'image-contain-marin':offer.image.includes('marin-food-05')}} src={offer.image} alt="" width="640" height="480" loading="lazy" /></div>
    <div class="offer-copy"><span class="offer-image-credit">{offer.imageCredit}</span>
    {headingLevel===2?<h2>{offer.title}</h2>:<h3>{showServices?(services.find(service=>service.slug===offer.serviceSlug)?.name||offer.title):offer.title}</h3>}
    <p>{offer.description}</p>
    <a class="offer-link" href={`/services/${offer.serviceSlug}/`} aria-label={`Explore ${services.find(service=>service.slug===offer.serviceSlug)?.name||offer.title}`}>{offer.featured?'Explore ongoing support':offer.serviceSlug==='branding'?'Explore branding':offer.serviceSlug==='web-design'?'Explore websites':'Explore packaging'} <ActionIcon name="forward" /></a></div>
  </article>)}
</div>
{mobileCarousel&&<WorkCarouselControls target="home-services-carousel" itemLabel="service" />}
<style>
  .offer-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;align-items:stretch}
  .offer-card{display:flex;flex-direction:column;min-width:0;padding:20px 20px 24px;border:1px solid #d7dce0;border-radius:23px;background:#fff;transition:transform .25s,box-shadow .25s}
  .offer-card-featured{background:#303963;color:#fff;border-color:#303963}
  .offer-card-packaging{background:#f0f4d7}
  .offer-copy{display:flex;flex-direction:column;flex:1;min-width:0}
  .offer-image{overflow:hidden;border-radius:14px;aspect-ratio:1.48;background:#e7e9e5;margin-bottom:10px}
  .offer-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
  .offer-image-credit{display:block;margin-bottom:18px;font-size:.75rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;line-height:1.4;opacity:.78}
  .offer-card h2,.offer-card h3{font-size:clamp(1.55rem,2.2vw,2.4rem);line-height:1.16;margin-bottom:14px}
  .offer-copy>p{font-size:.87rem;line-height:1.6;margin-bottom:16px}
  .offer-link{display:flex;align-items:center;justify-content:center;text-align:center;gap:10px;margin-top:auto;border-radius:100px;padding:13px 15px;background:var(--ink);color:#fff;font-size:.67rem;text-transform:uppercase;letter-spacing:.04em;font-weight:800}
  .offer-card-featured .offer-link{background:var(--lime);color:var(--ink)}
  @media(hover:hover) and (prefers-reduced-motion:no-preference){.offer-card:hover{transform:translateY(-6px);box-shadow:0 20px 36px #24274318}.offer-card:hover img{transform:scale(1.035)}}
  @media(max-width:1100px){.offer-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.offer-card{padding:24px}.offer-card h2,.offer-card h3{font-size:2rem}}
  @media(max-width:620px){.offer-grid{grid-template-columns:1fr}.offer-card{padding:20px}.offer-image{aspect-ratio:1.65}.offer-card h2,.offer-card h3{font-size:1.85rem}}
  @media(prefers-reduced-motion:reduce){.offer-card,.offer-image img{transition:none}}
</style>
