---
type Name='conversation'|'direction'|'commerce'|'momentum'|'journey'|'partnership';
interface Props {name:Name;}
const {name}=Astro.props;
---
<svg class="benefit-illustration" data-benefit-art={name} width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
 <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name==='conversation'&&<>
   <path d="M8 12h31a5 5 0 0 1 5 5v17a5 5 0 0 1-5 5H22L12 47v-8a4 4 0 0 1-4-4Z" fill="var(--brand-mint,#d8ffc2)" />
   <path d="M31 27h21a4 4 0 0 1 4 4v14a4 4 0 0 1-4 4v8l-10-8H31a4 4 0 0 1-4-4V31a4 4 0 0 1 4-4Z" fill="var(--brand-paper,#fffdf4)" />
   <path d="M17 23h18M17 29h10M35 37h13M35 42h9" />
   <circle cx="49" cy="13" r="5" fill="var(--brand-yellow,#e6f254)" />
  </>}
  {name==='direction'&&<>
   <circle cx="32" cy="32" r="23" />
   <path d="m24 24 24-8-8 24-24 8Z" fill="var(--brand-mint,#d8ffc2)" />
   <path d="m24 24 16 16M32 5v6M32 53v6M5 32h6M53 32h6" />
   <circle cx="32" cy="32" r="4" fill="var(--brand-yellow,#e6f254)" />
  </>}
  {name==='commerce'&&<>
   <path d="M8 14h25v33H8Z" fill="var(--brand-mint,#d8ffc2)" />
   <path d="M15 14v9h11v-9M7 51h28" />
   <path d="m33 31 2 24h21l2-24Z" fill="var(--brand-paper,#fffdf4)" />
   <path d="M39 33v-7a6 6 0 0 1 12 0v7" />
   <path d="m41 43 3 3 6-6" />
   <path d="m45 7 2 4 4 2-4 2-2 4-2-4-4-2 4-2Z" fill="var(--brand-yellow,#e6f254)" />
  </>}
  {name==='momentum'&&<>
   <rect x="8" y="28" width="20" height="24" rx="4" fill="var(--brand-mint,#d8ffc2)" />
   <rect x="21" y="20" width="20" height="24" rx="4" fill="var(--brand-paper,#fffdf4)" />
   <rect x="34" y="12" width="20" height="24" rx="4" fill="var(--brand-yellow,#e6f254)" />
   <path d="m39 24 3 3 6-7M10 13h14m-5-5 5 5-5 5M40 51h14" />
  </>}
  {name==='journey'&&<>
   <path d="M10 16h23a11 11 0 0 1 0 22H23a11 11 0 0 0 0 22h12" />
   <circle cx="10" cy="16" r="5" fill="var(--brand-mint,#d8ffc2)" />
   <path d="m37 33 20 9-9 4-4 9Z" fill="var(--brand-yellow,#e6f254)" />
   <path d="m48 46 8 10M45 11v7M41.5 14.5h7" />
  </>}
  {name==='partnership'&&<>
   <rect x="8" y="23" width="33" height="17" rx="8.5" transform="rotate(-35 24.5 31.5)" fill="var(--brand-mint,#d8ffc2)" />
   <rect x="23" y="23" width="33" height="17" rx="8.5" transform="rotate(-35 39.5 31.5)" fill="var(--brand-paper,#fffdf4)" />
   <path d="m24 38 16-12" />
   <path d="m48 6 2 5 5 2-5 2-2 5-2-5-5-2 5-2Z" fill="var(--brand-yellow,#e6f254)" />
   <path d="M13 49v6M10 52h6" />
  </>}
 </g>
</svg>
