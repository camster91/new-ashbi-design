---
// Why us — static section. `scroll-right` is a layout class used by the CSS.
---
<section class="sec_why">
  <div class="padding-section-medium"></div>
  <div class="padding-global">
    <div class="container-large">
      <div class="why_layout">
        <div data-reveal>
          <div data-wf--tag-section--variant="base" class="tag">
            <div class="dot-square"></div>
            <div>Why us</div>
          </div>
          <div class="spacer-large"></div>
          <div class="max-width-medium">
            <h2 class="scroll-right">We build solutions that create real, measurable impact</h2>
          </div>
          <div class="spacer-large"></div>
          <div class="max-width-medium is-34rem">
            <div class="text-base text-color-secondary scroll-right">Our approach blends strategic consulting, human-centered design, and advanced AI — giving you the clarity, tools, and confidence to thrive in the age of intelligence.</div>
          </div>
        </div>
        <div data-reveal="scale" data-reveal-scale="0.75" class="why_img"><img src="/images/why-img.avif" loading="lazy" alt="" class="img"></div>
      </div>
    </div>
  </div>
  <div class="padding-section-medium"></div>
</section>
