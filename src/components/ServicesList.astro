---
// Services list — sec_serv-services section, CMS-bound.
// Each card binds name (h3), summary (text), icon, and link → /services/{id}.
// The per-card decorative visuals (visual_wrap-first/second/third) are static markup
// selected by card index; their data-anim hooks drive the scroll animations.
import { getCollection } from "astro:content";

const services = (await getCollection("services")).sort((a, b) => {
  const order = ["ai-strategy", "business-consulting", "data-insights"];
  return order.indexOf(a.id) - order.indexOf(b.id);
});
---
<section class="sec_serv-services">
  <div class="padding-section-medium"></div>
  <div class="padding-global">
    <div class="container-large">
      <div data-reveal class="vertical-center">
        <div data-wf--tag-section--variant="base" class="tag">
          <div class="dot-square"></div>
          <div>Services</div>
        </div>
        <div class="spacer-large"></div>
        <div class="max-width-medium is-45rem">
          <h2 class="text-align-center">Comprehensive consulting and intelligent innovation</h2>
        </div>
        <div class="spacer-large"></div>
        <div class="max-width-medium">
          <div class="text-base text-color-secondary text-align-center">Whether you’re optimizing today or building for tomorrow  we help you move faster with confidence.</div>
        </div>
      </div>
      <div class="spacer-section-medium"></div>
      <div class="serv-services_layout">
        {services.map((service, i) => (
          <div class={i === 0 ? "serv-service_card" : "serv-service_card is-one-row"}>
            <div>
              <div class="container-icon bg-green"><img src={service.data.icon} loading="lazy" alt="" class="icon-1x1-medium"></div>
              <div class="spacer-xlarge"></div>
              <h3 class="text-3xl" set:html={service.data.name}></h3>
              <div class="spacer-xsmall"></div>
              <div class="text-base text-color-secondary">{service.data.summary}</div>
              <div class="spacer-xhuge"></div>
              <div class="button_wrapper">
                <a data-wf--button--variant="bg-gray" href={`/services/${service.id}`} class="button w-variant-29a3d87d-0352-056f-f3fc-7e15705035cc w-inline-block">
                  <div class="text-button-wrap">
                    <div>Learn more</div>
                  </div>
                </a>
              </div>
            </div>
            {i === 0 && (
              <div class="serv-service_img">
                <div class="visual_wrap-first">
                  <div data-anim="card-reveal" class="vcard">
                    <div class="vcard_inner">
                      <div class="vcard_section">
                        <div class="vcard_text-group">
                          <p data-anim="fade-up" class="vcard_text-label text-weight-medium">Monthly expanse</p>
                          <div data-anim="fade-up" class="vcard_amount-wrap">
                            <div class="text-wrap">
                              <div class="vcard_text-amount">$</div>
                              <div class="vcard_text-amount">4900</div>
                            </div>
                            <p class="vcard_text-amount-muted text-weight-medium">/ $10,000</p>
                          </div>
                        </div>
                        <div data-anim="progress" class="vcard_progress-bg">
                          <div class="vcard_progress-fill"></div>
                        </div>
                      </div>
                      <div data-anim="stagger-rows" class="vcard_section-list">
                        {[0, 1, 2].map(() => (
                          <div class="vcard_row">
                            <div class="vcard_row-left"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 16 11" fill="none" class="vcard_row-icon">
                                <g clip-path="url(#clip0_15680_42637)">
                                  <path fill-rule="evenodd" clip-rule="evenodd" d="M3.7711 1.55387L0 5.28706C0.75429 6.03378 1.61595 6.66309 2.5554 7.15543C2.81507 7.83731 3.2221 8.47678 3.77647 9.02557C5.86218 11.0903 9.24374 11.0903 11.3294 9.02557C11.8838 8.47678 12.2908 7.83731 12.5505 7.15539C13.4899 6.66309 14.3516 6.03378 15.1059 5.28706L11.3378 1.55691C11.335 1.55412 11.3322 1.55133 11.3294 1.54854C9.24374 -0.51618 5.86218 -0.51618 3.77647 1.54854C3.77468 1.55032 3.77289 1.55209 3.7711 1.55387ZM10.9686 7.82896C9.86962 8.19611 8.71598 8.38414 7.55294 8.38414C6.3899 8.38414 5.2363 8.19611 4.13735 7.82896C4.25642 7.98535 4.38788 8.13542 4.53176 8.27787C6.20032 9.92966 8.90556 9.92966 10.5741 8.27787C10.718 8.13542 10.8495 7.98535 10.9686 7.82896ZM4.60922 2.22147C4.89257 2.40679 5.19386 2.56536 5.50912 2.69465C6.15708 2.96034 6.85158 3.0971 7.55294 3.0971C8.25431 3.0971 8.9488 2.96034 9.59677 2.69465C9.91203 2.56536 10.2133 2.40678 10.4967 2.22146C8.84895 0.66939 6.25693 0.669394 4.60922 2.22147Z" fill="currentColor"></path>
                                </g>
                                <defs>
                                  <clippath id="clip0_15680_42637">
                                    <rect width="15.1059" height="10.5741" fill="currentColor"></rect>
                                  </clippath>
                                </defs>
                              </svg>
                              <div class="vcard_row-info">
                                <p class="vcard_text-label text-weight-medium">Vit premium</p>
                                <p class="vcard_text-date text-weight-medium">November 14, 2025</p>
                              </div>
                            </div>
                            <p class="vcard_text-price text-weight-medium">$120</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                  <div data-anim="card-reveal" class="pcard">
                    <div class="pcard_inner">
                      <div class="pcard_header">
                        <div data-anim="fade-up" class="pcard_header-text">
                          <p class="pcard_text-title">Performance</p>
                          <p class="pcard_text-muted">In the past 7 days</p>
                        </div><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 24 24" fill="none" data-anim="fade-up" class="pcard_icon">
                          <path d="M4.20065 17.7827L9.50065 12.4827L12.7506 15.7327C13.1606 16.1427 13.8206 16.1227 14.2006 15.6927L21.3706 7.62274C21.7206 7.23274 21.7006 6.63274 21.3306 6.25274C21.2345 6.15693 21.1199 6.08169 20.9938 6.03158C20.8677 5.98148 20.7327 5.95758 20.5971 5.96132C20.4614 5.96506 20.3279 5.99637 20.2048 6.05335C20.0816 6.11033 19.9713 6.19178 19.8806 6.29274L13.4906 13.4727L10.2006 10.1827C10.1081 10.09 9.99824 10.0165 9.87727 9.96631C9.7563 9.91613 9.62662 9.8903 9.49565 9.8903C9.36468 9.8903 9.235 9.91613 9.11402 9.96631C8.99305 10.0165 8.88316 10.09 8.79065 10.1827L2.70065 16.2827C2.60794 16.3753 2.5344 16.4851 2.48421 16.6061C2.43403 16.7271 2.4082 16.8568 2.4082 16.9877C2.4082 17.1187 2.43403 17.2484 2.48421 17.3694C2.5344 17.4903 2.60794 17.6002 2.70065 17.6927L2.79065 17.7827C3.18065 18.1727 3.82065 18.1727 4.20065 17.7827Z" fill="fff"></path>
                        </svg>
                      </div>
                      <div data-anim="fade-up" class="pcard_body">
                        <div class="text-wrap">
                          <div class="pcard_text-value">50</div>
                          <div class="pcard_text-value">+</div>
                        </div>
                        <p class="pcard_text-muted">Monthly expanse</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}
            {i === 1 && (
              <div class="serv-service_img is-two">
                <div class="visual_wrap-second">
                  <div data-anim="card-reveal" class="bcard">
                    <div class="bcard_inner">
                      <div data-anim="fade-up" class="bcard_title-wrap">
                        <p class="bcard_text-title">Intelligence in Every Decision</p>
                      </div>
                      <div data-anim="bar-grow" class="bcard_chart">
                        <div class="bcard_chart-col">
                          <div class="bcard_bar"></div>
                          <p class="bcard_text-year">2019</p>
                        </div>
                        <div class="bcard_chart-col">
                          <div class="bcard_bar"></div>
                          <p class="bcard_text-year">2020</p>
                        </div>
                        <div class="bcard_chart-col">
                          <div class="bcard_bar is-h2"></div>
                          <p class="bcard_text-year">2021</p>
                        </div>
                        <div class="bcard_chart-col">
                          <div class="bcard_bar is-h3"></div>
                          <p class="bcard_text-year">2022</p>
                        </div>
                        <div class="bcard_chart-col">
                          <div class="bcard_bar is-h4"></div>
                          <p class="bcard_text-year">2023</p>
                        </div>
                        <div class="bcard_chart-col">
                          <div class="bcard_bar is-fill"></div>
                          <p class="bcard_text-year">2024</p>
                        </div>
                        <div class="bcard_chart-col">
                          <div class="bcard_bar is-active is-h5"></div>
                          <p class="bcard_text-year">2025</p>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div data-anim="card-reveal" class="ecard">
                    <div data-anim="stagger-text" class="ecard_inner">
                      <p class="ecard_text">Expertise</p>
                      <div class="ecard_badge"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 17 17" fill="none" class="ecard_badge-icon">
                          <rect width="16.9398" height="16.9398" rx="8.46988" fill="000"></rect>
                          <g clip-path="url(#clip0_15685_42665)">
                            <path d="M8.47038 4.9375C7.8152 4.9375 7.18685 5.19777 6.72356 5.66106C6.26027 6.12435 6 6.7527 6 7.40788C6 8.24781 6.41997 8.9854 7.05874 9.4336V10.2312C7.05874 10.3248 7.09592 10.4145 7.1621 10.4807C7.22829 10.5469 7.31805 10.5841 7.41165 10.5841H9.52912C9.62272 10.5841 9.71248 10.5469 9.77867 10.4807C9.84485 10.4145 9.88203 10.3248 9.88203 10.2312V9.4336C10.5208 8.9854 10.9408 8.24781 10.9408 7.40788C10.9408 6.7527 10.6805 6.12435 10.2172 5.66106C9.75392 5.19777 9.12557 4.9375 8.47038 4.9375ZM7.41165 11.6428C7.41165 11.7364 7.44883 11.8262 7.51501 11.8924C7.5812 11.9586 7.67096 11.9957 7.76456 11.9957H9.17621C9.26981 11.9957 9.35957 11.9586 9.42575 11.8924C9.49194 11.8262 9.52912 11.7364 9.52912 11.6428V11.2899H7.41165V11.6428Z" fill="currentColor"></path>
                          </g>
                          <defs>
                            <clippath id="clip0_15685_42665">
                              <rect width="8.46989" height="8.46989" fill="currentColor" transform="translate(4.23438 4.23438)"></rect>
                            </clippath>
                          </defs>
                        </svg></div>
                      <p class="text-muted-40">that</p>
                      <p class="text-muted-40">Combines</p>
                      <p class="text-muted-40">Strategy,</p>
                      <p class="ecard_text">Data,</p>
                      <p class="text-muted-40">and Artificial</p>
                      <p class="ecard_text">Intelligence</p>
                    </div>
                  </div>
                </div>
              </div>
            )}
            {i === 2 && (
              <div class="serv-service_img is-two">
                <div class="visual_wrap-third">
                  <div data-anim="card-reveal" class="gcard">
                    <div class="gcard_inner">
                      <div data-anim="fade-up" class="gcard_dark-block">
                        <div class="pcard_header">
                          <div class="pcard_header-text">
                            <p class="pcard_text-title">Performance</p>
                            <p class="pcard_text-muted">In the past 7 days</p>
                          </div><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewbox="0 0 24 24" fill="none" class="pcard_icon">
                            <path d="M4.20065 17.7827L9.50065 12.4827L12.7506 15.7327C13.1606 16.1427 13.8206 16.1227 14.2006 15.6927L21.3706 7.62274C21.7206 7.23274 21.7006 6.63274 21.3306 6.25274C21.2345 6.15693 21.1199 6.08169 20.9938 6.03158C20.8677 5.98148 20.7327 5.95758 20.5971 5.96132C20.4614 5.96506 20.3279 5.99637 20.2048 6.05335C20.0816 6.11033 19.9713 6.19178 19.8806 6.29274L13.4906 13.4727L10.2006 10.1827C10.1081 10.09 9.99824 10.0165 9.87727 9.96631C9.7563 9.91613 9.62662 9.8903 9.49565 9.8903C9.36468 9.8903 9.235 9.91613 9.11402 9.96631C8.99305 10.0165 8.88316 10.09 8.79065 10.1827L2.70065 16.2827C2.60794 16.3753 2.5344 16.4851 2.48421 16.6061C2.43403 16.7271 2.4082 16.8568 2.4082 16.9877C2.4082 17.1187 2.43403 17.2484 2.48421 17.3694C2.5344 17.4903 2.60794 17.6002 2.70065 17.6927L2.79065 17.7827C3.18065 18.1727 3.82065 18.1727 4.20065 17.7827Z" fill="fff"></path>
                          </svg>
                        </div>
                      </div>
                      <div data-anim="fade-up" class="gcard_stats">
                        <div class="gcard_value-row">
                          <div class="text-wrap">
                            <div class="pcard_text-value">49</div>
                            <div class="pcard_text-value">%</div>
                          </div>
                          <div class="gcard_badge">
                            <p>+2.5%</p>
                          </div>
                        </div>
                        <p class="gcard_text-sub">Business growth</p>
                      </div>
                      <div data-anim="marquee-tags" class="gcard_tags">
                        <div data-anim="marquee-right" class="gcard_tags-row">
                          <div class="gcard_tag"><p>Professional</p></div>
                          <div class="gcard_tag"><p>Strategic</p></div>
                          <div class="gcard_tag"><p>AI-Focused</p></div>
                          <div class="gcard_tag"><p>Startup Feel</p></div>
                          <div class="gcard_tag"><p>Professional</p></div>
                          <div class="gcard_tag"><p>Strategic</p></div>
                          <div class="gcard_tag"><p>AI-Focused</p></div>
                          <div class="gcard_tag"><p>Startup Feel</p></div>
                        </div>
                        <div data-anim="marquee-left" class="gcard_tags-row">
                          <div class="gcard_tag"><p>Smarter</p></div>
                          <div class="gcard_tag"><p>Grow Faster</p></div>
                          <div class="gcard_tag"><p>Build Smart</p></div>
                          <div class="gcard_tag"><p>Simple</p></div>
                          <div class="gcard_tag"><p>Smarter</p></div>
                          <div class="gcard_tag"><p>Grow Faster</p></div>
                          <div class="gcard_tag"><p>Build Smart</p></div>
                          <div class="gcard_tag"><p>Simple</p></div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div data-anim="card-reveal" class="scard">
                    <div class="scard_inner">
                      <div data-anim="fade-up" class="scard_top-bar">
                        <div class="scard_avatars">
                          <div class="scard_avatar"><img loading="lazy" src="/images/profile.avif" alt="" class="img"></div>
                          <div class="scard_avatar"><img loading="lazy" src="/images/profile-1.avif" alt="" class="img"></div>
                          <div class="scard_avatar"><img loading="lazy" src="/images/profile-2.avif" alt="" class="img"></div>
                        </div>
                        <p class="pcard_text-muted">+5,000 customers</p>
                      </div>
                      <div data-anim="stagger-text" class="scard_text-wrap">
                        <p class="text-muted-40">Smart.</p>
                        <p class="text-muted-40">Simple.</p>
                        <p class="ecard_text">Strategic.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="padding-section-medium"></div>
</section>
