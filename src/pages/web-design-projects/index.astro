---
import ActionIcon from '../../components/ActionIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {commerceProjects} from '../../data/site';
---
<BaseLayout title="Website Design Portfolio | Ashbi Design" description="Explore selected website design work by Ashbi Design."><main id="main"><section class="interior-hero container"><span class="eyebrow">WEB DESIGN PROJECTS</span><h1>Website design portfolio for product brands.</h1><p>Selected website work from Ashbi Design.</p></section><section class="section container project-grid">{commerceProjects.filter(p=>p.categories.includes('Websites')).map(p=><a class="project-tile" href={`/work/${p.slug}/`}><img src={p.cardImage||p.image} style={`object-position:${p.cardImagePosition||'center'}`} alt="" /><span>{p.category}</span><h2>{p.name} <ActionIcon name="forward" /></h2></a>)}</section></main></BaseLayout>
