---
import BaseLayout from '../layouts/BaseLayout.astro';
import OfferGrid from '../components/OfferGrid.astro';
import BookingCta from '../components/BookingCta.astro';
---
<BaseLayout title="Ways to Work With Ashbi Design" description="Explore brand, website, packaging, and ongoing creative projects with Ashbi Design." noindex={true}><main id="main"><section class="interior-hero container"><span class="eyebrow">WAYS TO WORK TOGETHER</span><h1>A scope shaped <em>around your work.</em></h1><p>Choose a starting point below. Every engagement is scoped around your goals, deliverables, and schedule before work begins.</p><a class="button button-lime" href="/contact/">Book a call ↗</a></section><section class="section container"><OfferGrid headingLevel={2} /></section><BookingCta /></main></BaseLayout>
