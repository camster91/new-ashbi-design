---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';
import BookingCta from '../components/BookingCta.astro';
import {commerceProjects,faqs} from '../data/site';
import QuoteMarquee from '../components/QuoteMarquee.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import OfferGrid from '../components/OfferGrid.astro';
// Lead Marin with its food packaging rather than the tote-bag application.
const homepageProjects=commerceProjects.map(project=>project.slug==='marin-food'?{
  ...project,
  cardImage:'/images/ashbi/gallery/marin-food-05-1800.webp',
  cardImageAlt:'Marin Food gourmet butter packaging in five flavour variants',
}:project);
const heroProjects=homepageProjects.slice(0,12);
// Read the first two columns top to bottom: Della, BPM, Marin Food, CocoFro.
const heroRows=[
  heroProjects.slice(0,4),
  heroProjects.slice(4),
];
// Featured brand marks, from original Figma files and the official CocoFro website (see public/images/ashbi/brands/SOURCES.md).
const featuredBrands=[
  {name:'Della',logo:'/images/ashbi/brands/della-logo.svg',w:117,h:35},
  {name:'BPM',logo:'/images/ashbi/brands/bpm-logo.svg',w:46,h:45},
  {name:'Marin Food',logo:'/images/ashbi/brands/marin-logo.png',w:158,h:36},
  {name:'CocoFro',logo:'/images/ashbi/brands/cocofro-logo.png',w:99,h:60},
];
---
<BaseLayout title="Ashbi Design | Brand Identity, Packaging & Web Design" description="Ashbi is a Toronto branding and web design studio creating distinctive identities, packaging, and digital experiences for ambitious businesses.">
<main id="main">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy"><span class="eyebrow">TORONTO CREATIVE STUDIO ✦ BRAND · WEB · PACKAGING</span><h1 id="hero-title">Brands with <em>personality.</em><br />Websites built to <em>work.</em></h1><p>Brand identity, packaging, and ecommerce websites for the products people bring home.</p><div class="hero-actions"><a class="button button-lime" href="/contact/">Book a call <span aria-hidden="true">↗</span></a><a class="button button-outline" href="#selected-work">Explore our work <span aria-hidden="true">↓</span></a></div></div>
    <div class="hero-reel-stage" role="region" aria-label="Ashbi project gallery">
      {heroRows.map((row,rowIndex)=><div class={`hero-reel hero-reel-${rowIndex===0?'back':'front'}`} data-hero-reel data-direction={rowIndex===0?-1:1} tabindex="0" aria-label={`${rowIndex===0?'Upper':'Lower'} project row. Swipe or use the arrow keys to browse.`}>
        {[0,1].map(copy=><div class="hero-reel-set" aria-hidden={copy===1?'true':undefined}>{row.map((project,i)=><a class="reel-card" draggable="false" href={`/work/${project.slug}/`} tabindex={copy===1?-1:undefined} aria-label={`View ${project.name} case study`}><img src={project.cardImage||project.image} alt="" style={`object-position:${project.cardImagePosition||'center'}`} width="480" height="360" loading={copy===0&&i<5?'eager':'lazy'} fetchpriority={rowIndex===0&&copy===0&&i===0?'high':undefined} /></a>)}</div>)}
      </div>)}
      <div class="hero-reel-controls"><button type="button" data-reel-prev aria-label="Scroll projects left">←</button><button type="button" data-reel-next aria-label="Scroll projects right">→</button></div>
    </div>
    <button class="motion-toggle" type="button" data-motion-toggle aria-label="Pause gallery motion" aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button>
  </section>
  <section class="client-strip container" aria-label="Featured brands"><span class="eyebrow">FEATURED BRANDS</span><ul class="client-track client-logos">{featuredBrands.map(b=><li>{b.logo?<img src={b.logo} alt={b.name} width={b.w} height={b.h} style={`height:${b.h}px`} loading="lazy" decoding="async" />:<span>{b.name}</span>}</li>)}</ul></section>
  <WorkList projects={homepageProjects} />
  <section class="section proof-section container" aria-labelledby="proof-heading"><div class="section-heading"><span class="eyebrow">CLIENT WORDS</span><h2 id="proof-heading">From the people we work with.</h2></div><QuoteMarquee /></section>
  <section class="section ways-section container" id="services" aria-labelledby="services-heading"><div class="section-heading"><span class="eyebrow">SERVICES & PARTNERSHIPS</span><h2 id="services-heading">What do you need next?</h2><p>Build your brand, launch a website, or bring a product to market. Start with a focused project, or work with us as your ongoing creative partner.</p></div><OfferGrid showServices /></section>
  <section class="section studio-section container" aria-labelledby="studio-heading"><div class="studio-photo reveal"><img src="/images/ashbi/studio-detail.webp" alt="Bianca and Cameron at the Ashbi studio" loading="lazy" width="1080" height="1080" /><div class="photo-label">BIANCA & CAMERON · TORONTO</div></div><div class="studio-copy reveal"><span class="eyebrow">YOUR CREATIVE PARTNERS</span><h2 id="studio-heading">Bianca + Cameron.</h2><p>We run Ashbi together. Bianca leads the brand and design work; Cameron connects it to the website, the technology, and the way your business runs. You work directly with us from the first conversation through the final handoff.</p><div class="studio-names"><span><b>Bianca</b> · Creative direction</span><span><b>Cameron</b> · Digital strategy & development</span></div><a class="text-link" href="/studio/">Meet the studio <span aria-hidden="true">↗</span></a></div></section>
  <section class="section process-section" aria-labelledby="process-heading"><div class="container"><div class="section-heading"><span class="eyebrow">HOW WE WORK</span><h2 id="process-heading">From the first conversation to launch.</h2><p>Each stage has a purpose, a conversation, and work you can see.</p></div><ProcessSteps /></div></section>
  <section class="section faq-section container" aria-labelledby="faq-heading"><div class="faq-intro"><span class="eyebrow">GOOD TO KNOW</span><h2 id="faq-heading">Before we get started.</h2><p>Still have a question? <a href="mailto:hello@ashbi.ca">Say hello ↗</a></p></div><div class="faq-list">{faqs.map(item=><details><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></section>
  <BookingCta />
</main>
</BaseLayout>

<style>
  .hero-reel-stage img[src*="marin-food-05-"]{object-fit:contain;background:#88000d}
  :global(.work-feature img[src*="marin-food-05-"]){object-fit:contain;background:#88000d}
</style>
