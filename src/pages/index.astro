---
import BenefitIllustration from '../components/BenefitIllustration.astro';
import ActionIcon from '../components/ActionIcon.astro';
import rawHomeContent from '../data/home-content.json';
import {validateHomeContent} from '../lib/content';
const homeContent=validateHomeContent(rawHomeContent);
import BrandMarquee from '../components/BrandMarquee.astro';
import BrandAccent from '../components/BrandAccent.astro';
import '../styles/brand-home.css';
import {site} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';
import BookingCta from '../components/BookingCta.astro';
import {commerceProjects,faqs} from '../data/site';
import QuoteMarquee from '../components/QuoteMarquee.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import OfferGrid from '../components/OfferGrid.astro';
// Lead Marin with its food packaging rather than the tote-bag application.
const homepageProjects=commerceProjects.map(project=>project.slug==='marin-food'?{
  ...project,
  cardImage:'/images/ashbi/gallery/marin-food-05-1800.webp',
  cardImageAlt:'Marin Food gourmet butter packaging in five flavour variants',
}:project);
const heroProjects=homepageProjects.slice(0,12);
// Read the first two columns top to bottom: Della, BPM, Marin Food, CocoFro.
const heroRows=[
  heroProjects.slice(0,4),
  heroProjects.slice(4),
];
---
<BaseLayout title="Ashbi Design | Brand Identity, Packaging & Web Design" description="Ashbi is a Toronto creative studio for growing product brands. Work directly with Bianca and Cameron on brand identity, packaging and ecommerce websites.">
<main id="main" data-home-motion>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-character"><BrandAccent /></div><div class="hero-copy"><span class="eyebrow">{homeContent.heroEyebrow}</span><h1 id="hero-title">Design for product brands.</h1><p>{homeContent.heroIntro}</p><div class="hero-actions"><a class="button button-lime" href={site.bookingUrl} data-track="booking_calendar_click">Book a call <ActionIcon name="external" /></a><a class="button button-outline" href="#selected-work">Explore our work <ActionIcon name="down" /></a></div></div>
    <div class="hero-reel-stage" role="region" aria-label="Ashbi project gallery">
      {heroRows.map((row,rowIndex)=><div class={`hero-reel hero-reel-${rowIndex===0?'back':'front'}`} data-hero-reel data-direction={rowIndex===0?-1:1} tabindex="0" aria-label={`${rowIndex===0?'Upper':'Lower'} project row. Swipe or use the arrow keys to browse.`}>
        {[0,1,2].map(copy=><div class="hero-reel-set" aria-hidden={copy!==1?'true':undefined}>{row.map((project,i)=><a class="reel-card" draggable="false" href={`/work/${project.slug}/`} tabindex={copy!==1?-1:undefined} aria-label={`View ${project.name} case study`}><img src={project.cardImage||project.image} alt="" style={`object-position:${project.cardImagePosition||'center'}`} width="480" height="360" loading={copy===1&&i<5?'eager':'lazy'} fetchpriority={rowIndex===0&&copy===1&&i===0?'high':undefined} /></a>)}</div>)}
      </div>)}
      <div class="hero-reel-controls"><button type="button" data-reel-prev aria-label="Scroll projects left"><ActionIcon name="back" /></button><button type="button" data-reel-next aria-label="Scroll projects right"><ActionIcon name="forward" /></button></div>
    </div>
    <button class="motion-toggle" type="button" data-motion-toggle aria-label="Pause page motion" aria-pressed="false"><span class="motion-icon-pause"><ActionIcon name="pause" /></span><span class="motion-icon-play"><ActionIcon name="play" /></span></button>
  </section>
  <BrandMarquee />
  <WorkList projects={homepageProjects} intro={homeContent.workIntro} />
  <section class="section proof-section container" aria-labelledby="proof-heading"><div class="section-heading"><span class="eyebrow">CLIENT WORDS</span><h2 id="proof-heading">From the people we work with.</h2></div><QuoteMarquee /></section>
  <section class="section ways-section container" id="services" aria-labelledby="services-heading"><div class="section-heading"><span class="eyebrow">SERVICES & PARTNERSHIPS</span><h2 id="services-heading">Branding, packaging and websites.</h2><p>{homeContent.servicesIntro}</p></div><BrandAccent variant="stamp" label="Your creative partners" /><OfferGrid showServices mobileCarousel /></section>
  <section class="section studio-section container" aria-labelledby="studio-heading"><div class="studio-photo reveal"><img src="/images/ashbi/studio-detail.webp" alt="Bianca and Cameron at the Ashbi studio" loading="lazy" width="1080" height="1080" /><div class="photo-label">BIANCA & CAMERON · TORONTO</div></div><div class="studio-copy reveal"><span class="eyebrow">YOUR CREATIVE PARTNERS</span><h2 id="studio-heading">Meet Bianca and Cameron.</h2><p class="studio-introduction">We’re Bianca + Cameron.</p><p>{homeContent.studioIntro}</p><div class="studio-names"><span><b>Bianca</b> · Creative direction</span><span><b>Cameron</b> · Digital strategy & development</span></div><a class="text-link" href="/studio/">Meet the studio <ActionIcon name="forward" /></a></div></section>
  <section class="section container studio-benefits" aria-labelledby="benefits-heading">
    <div class="section-heading"><span class="eyebrow">WORKING WITH ASHBI</span><h2 id="benefits-heading">Work directly with us.</h2><p>Work with the people designing your brand and building your website.</p></div>
    <div class="benefit-grid">
      <article><BenefitIllustration name="conversation" /><h3>Design and development together.</h3><p>Bianca leads design; Cameron leads websites and development. You speak with us directly about the brief, the work and your feedback.</p></article>
      <article><BenefitIllustration name="direction" /><h3>Start with your customers.</h3><p>We look at who you want to reach, what you offer and what makes it different. Those decisions guide the design.</p></article>
      <article><BenefitIllustration name="commerce" /><h3>Connect your packaging and website.</h3><p>Carry the same identity from a product’s packaging to its online store, so customers can recognise your brand in both places.</p></article>
      <article><BenefitIllustration name="momentum" /><h3>Know what happens next.</h3><p>We agree the scope, schedule and review stages before we start. You know what to expect and when we need your feedback.</p></article>
      <article><BenefitIllustration name="journey" /><h3>Make the website easy to use.</h3><p>Navigation, product information and page layouts should help visitors find what they need, compare options and shop or enquire.</p></article>
      <article><BenefitIllustration name="partnership" /><h3>Get support after launch.</h3><p>Come back for campaign graphics, a new product or website updates. Ongoing work can be planned around your team’s priorities.</p></article>
    </div>
    <a class="text-link" href="/services/design-and-dev-subscription/">Explore ongoing support <ActionIcon name="forward" /></a>
  </section>
  <section class="section process-section" aria-labelledby="process-heading"><div class="container"><div class="section-heading"><span class="eyebrow">HOW WE WORK</span><h2 id="process-heading">From the brief to launch.</h2><p>We agree the direction, share designs for feedback and prepare the final files or website.</p></div><ProcessSteps /></div></section>
  <section class="section faq-section container" aria-labelledby="faq-heading"><div class="faq-intro"><span class="eyebrow">GOOD TO KNOW</span><h2 id="faq-heading">Before we get started.</h2><p>Still have a question? <a href="mailto:hello@ashbi.ca">Say hello <ActionIcon name="mail" /></a></p></div><div class="faq-list">{faqs.map(item=><details><summary>{item.q}<ActionIcon name="plus" /></summary><p>{item.a}</p></details>)}</div></section>
  <BookingCta expressive />
</main>
</BaseLayout>

<style>
  .hero-reel-stage img[src*="marin-food-05-"]{object-fit:contain;background:#88000d}
  .hero-reel-stage img[src*="/bpm/web-hero-720"]{object-fit:contain;background:#f7b46f}
  :global(.work-feature img[src*="marin-food-05-"]){object-fit:contain;background:#88000d}
  :global(.work-feature img[src*="/bpm/web-hero-720"]){object-fit:contain;background:#f7b46f}
</style>
