---
import rawHomeContent from '../data/home-content.json';
import {validateHomeContent} from '../lib/content';
const homeContent=validateHomeContent(rawHomeContent);
import BrandMarquee from '../components/BrandMarquee.astro';
import BrandAccent from '../components/BrandAccent.astro';
import '../styles/brand-home.css';
import {site} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkList from '../components/WorkList.astro';
import BookingCta from '../components/BookingCta.astro';
import {commerceProjects,faqs} from '../data/site';
import QuoteMarquee from '../components/QuoteMarquee.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import OfferGrid from '../components/OfferGrid.astro';
// Lead Marin with its food packaging rather than the tote-bag application.
const homepageProjects=commerceProjects.map(project=>project.slug==='marin-food'?{
  ...project,
  cardImage:'/images/ashbi/gallery/marin-food-05-1800.webp',
  cardImageAlt:'Marin Food gourmet butter packaging in five flavour variants',
}:project);
const heroProjects=homepageProjects.slice(0,12);
// Read the first two columns top to bottom: Della, BPM, Marin Food, CocoFro.
const heroRows=[
  heroProjects.slice(0,4),
  heroProjects.slice(4),
];
---
<BaseLayout title="Ashbi Design | Brand Identity, Packaging & Web Design" description="Ashbi is a Toronto branding and web design studio creating distinctive identities, packaging, and digital experiences for ambitious businesses.">
<main id="main" data-home-motion>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-character"><BrandAccent /></div><div class="hero-copy"><span class="eyebrow">{homeContent.heroEyebrow}</span><h1 id="hero-title">Brands with <em class="editorial">personality.</em><br />Websites built to <em class="editorial">work.</em></h1><p>{homeContent.heroIntro}</p><div class="hero-actions"><a class="button button-lime" href={site.bookingUrl} data-track="booking_calendar_click">Book a call <span aria-hidden="true">↗</span></a><a class="button button-outline" href="#selected-work">Explore our work <span aria-hidden="true">↓</span></a></div></div>
    <div class="hero-reel-stage" role="region" aria-label="Ashbi project gallery">
      {heroRows.map((row,rowIndex)=><div class={`hero-reel hero-reel-${rowIndex===0?'back':'front'}`} data-hero-reel data-direction={rowIndex===0?-1:1} tabindex="0" aria-label={`${rowIndex===0?'Upper':'Lower'} project row. Swipe or use the arrow keys to browse.`}>
        {[0,1].map(copy=><div class="hero-reel-set" aria-hidden={copy===1?'true':undefined}>{row.map((project,i)=><a class="reel-card" draggable="false" href={`/work/${project.slug}/`} tabindex={copy===1?-1:undefined} aria-label={`View ${project.name} case study`}><img src={project.cardImage||project.image} alt="" style={`object-position:${project.cardImagePosition||'center'}`} width="480" height="360" loading={copy===0&&i<5?'eager':'lazy'} fetchpriority={rowIndex===0&&copy===0&&i===0?'high':undefined} /></a>)}</div>)}
      </div>)}
      <div class="hero-reel-controls"><button type="button" data-reel-prev aria-label="Scroll projects left">←</button><button type="button" data-reel-next aria-label="Scroll projects right">→</button></div>
    </div>
    <button class="motion-toggle" type="button" data-motion-toggle aria-label="Pause page motion" aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button>
  </section>
  <BrandMarquee />
  <WorkList projects={homepageProjects} intro={homeContent.workIntro} />
  <section class="section proof-section container" aria-labelledby="proof-heading"><div class="section-heading"><span class="eyebrow">CLIENT WORDS</span><h2 id="proof-heading">From the people we work with.</h2></div><QuoteMarquee /></section>
  <section class="section ways-section container" id="services" aria-labelledby="services-heading"><div class="section-heading"><span class="eyebrow">SERVICES & PARTNERSHIPS</span><h2 id="services-heading">Good things.<br /><em class="editorial">Built together.</em></h2><p>{homeContent.servicesIntro}</p></div><BrandAccent variant="stamp" label="Your creative partners" /><OfferGrid showServices mobileCarousel /></section>
  <section class="section studio-section container" aria-labelledby="studio-heading"><div class="studio-photo reveal"><img src="/images/ashbi/studio-detail.webp" alt="Bianca and Cameron at the Ashbi studio" loading="lazy" width="1080" height="1080" /><div class="photo-label">BIANCA & CAMERON · TORONTO</div></div><div class="studio-copy reveal"><span class="eyebrow">YOUR CREATIVE PARTNERS</span><h2 id="studio-heading">Hey <em class="editorial">there,</em> hey!</h2><p class="studio-introduction">We’re Bianca + Cameron.</p><p>{homeContent.studioIntro}</p><div class="studio-names"><span><b>Bianca</b> · Creative direction</span><span><b>Cameron</b> · Digital strategy & development</span></div><a class="text-link" href="/studio/">Meet the studio <span aria-hidden="true">↗</span></a></div></section>
  <section class="section container studio-benefits" aria-labelledby="benefits-heading">
    <div class="section-heading"><span class="eyebrow">SMALL STUDIO. ALL IN.</span><h2 id="benefits-heading">Your ambitions.<br /><em class="editorial">Our sleeves rolled up.</em></h2><p>A close creative partnership, with the brand, design, and technical thinking in the same conversation.</p></div>
    <div class="benefit-grid">
      <article><span aria-hidden="true">↗</span><h3>Talk to the people making it.</h3><p>Work directly with Bianca and Cameron. Your feedback reaches the people shaping the design and building the website.</p></article>
      <article><span aria-hidden="true">✳</span><h3>Your story sets the direction.</h3><p>We start with your audience, product, and ambitions, then create an identity and experience that belong to your brand.</p></article>
      <article><span aria-hidden="true">↔</span><h3>From shelf to shopping cart.</h3><p>CPG, DTC, and ecommerce experience connects how your product looks, how it’s understood, and how people buy it.</p></article>
      <article><span aria-hidden="true">→</span><h3>Keep the work moving.</h3><p>A clear scope, agreed milestones, and consolidated feedback keep decisions moving. We confirm timing around your project before we start.</p></article>
      <article><span aria-hidden="true">◎</span><h3>Good looks. Clear next steps.</h3><p>We consider the whole customer journey: what people need to know, where they might hesitate, and what makes taking the next step easier.</p></article>
      <article><span aria-hidden="true">+</span><h3>A partner beyond launch.</h3><p>Keep a team that knows your brand close by. Ongoing support gives you room for new campaigns, product launches, and website improvements.</p></article>
    </div>
    <a class="text-link" href="/services/design-and-dev-subscription/">Explore ongoing support <span aria-hidden="true">↗</span></a>
  </section>
  <section class="section process-section" aria-labelledby="process-heading"><div class="container"><div class="section-heading"><span class="eyebrow">HOW WE WORK</span><h2 id="process-heading">A clear path.<br /><em class="editorial">From hello to launch.</em></h2><p>Each stage has a purpose, a conversation, and work you can see.</p></div><ProcessSteps /></div></section>
  <section class="section faq-section container" aria-labelledby="faq-heading"><div class="faq-intro"><span class="eyebrow">GOOD TO KNOW</span><h2 id="faq-heading">Before we get started.</h2><p>Still have a question? <a href="mailto:hello@ashbi.ca">Say hello ↗</a></p></div><div class="faq-list">{faqs.map(item=><details><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></section>
  <BookingCta expressive />
</main>
</BaseLayout>

<style>
  .hero-reel-stage img[src*="marin-food-05-"]{object-fit:contain;background:#88000d}
  .hero-reel-stage img[src*="/bpm/web-hero-720"]{object-fit:contain;background:#f7b46f}
  :global(.work-feature img[src*="marin-food-05-"]){object-fit:contain;background:#88000d}
  :global(.work-feature img[src*="/bpm/web-hero-720"]){object-fit:contain;background:#f7b46f}
</style>
