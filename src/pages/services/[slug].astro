---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingCta from '../../components/BookingCta.astro';
import QuoteGrid from '../../components/QuoteGrid.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import ServiceScope from '../../components/ServiceScope.astro';
import OngoingPlans from '../../components/OngoingPlans.astro';
import {services,projects} from '../../data/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
const related=service.projectSlugs.map(slug=>projects.find(p=>p.slug===slug)).filter(Boolean);
---
<BaseLayout title={`${service.name} | Ashbi Design`} description={service.summary} image={service.image}>
<main id="main" data-service-view={service.slug}>
<section class="interior-hero container service-detail-hero"><div><span class="eyebrow">{service.eyebrow}</span><h1>{service.name}<em>.</em></h1><p>{service.summary}</p><p>{service.fit}</p><div class="service-hero-actions"><a class="button button-lime" href="/contact/">Book a call ↗</a><a class="text-link" href="#service-scope">See what’s included ↓</a></div></div><img src={service.image} alt={`Example of Ashbi ${service.name.toLowerCase()} work`} width="900" height="700" /></section>
<section class="section container"><div class="section-heading"><span class="eyebrow">WHAT THIS WORK CAN DO</span><h2>Make the next move <em>more considered.</em></h2><p>The exact mix depends on where you are now and what your audience needs next.</p></div><div class="service-benefits">{service.benefits.map((benefit,i)=><article class="benefit-panel reveal"><span class="benefit-number">0{i+1}</span><h3>{benefit.title}</h3><p>{benefit.copy}</p></article>)}<div class="benefit-photo reveal"><img src={related[0]?.detail||service.image} alt={`${related[0]?.name||'Ashbi'} project detail`} loading="lazy" width="1000" height="750" /></div></div></section>
<section class="section container deliverables-section" id="service-scope"><div class="section-heading"><span class="eyebrow">WHAT WE CAN SHAPE TOGETHER</span><h2>Clear scope. <em>Useful deliverables.</em></h2><p>We agree the pieces your project needs before work begins.</p></div><div class="deliverables-grid">{service.deliverables.map((item,i)=><article class="deliverable reveal"><span>0{i+1} /</span><h3>{item.title}</h3><p>{item.copy}</p></article>)}</div></section>
{service.slug==='design-and-dev-subscription'?<OngoingPlans compact />:<ServiceScope service={service} />}
<section class="section container"><div class="section-heading"><span class="eyebrow">RELATED WORK</span><h2>See it in <em>practice.</em></h2></div><div class="project-grid service-projects">{related.map(p=>p&&<a class="project-tile" href={`/work/${p.slug}/`}><img src={p.image} alt="" loading="lazy" width="800" height="560" /><span>{p.categories.join(' · ')}</span><h3>{p.name} ↗</h3></a>)}</div></section>
<section class="section process-section"><div class="container"><div class="section-heading"><span class="eyebrow">HOW WE GET THERE</span><h2>Good conversations. <em>Clear next steps.</em></h2></div><ProcessSteps /></div></section>
<section class="section container" aria-label="Client feedback"><QuoteGrid ids={[service.testimonialId]} /></section>
<section class="section faq-section container"><div class="faq-intro"><span class="eyebrow">BEFORE WE BEGIN</span><h2>A little <em>more clarity.</em></h2>{service.articleSlug&&<a class="text-link" href={`/${service.articleSlug}/`}>Read our guide to good web design ↗</a>}</div><div class="faq-list">{service.faqs.map(f=><details><summary>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</div></section>
<BookingCta service={service.slug} />
</main></BaseLayout>
<style>.service-hero-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap}.service-hero-actions .text-link{font-size:.72rem}.service-detail-hero>div>p:nth-of-type(2){font-size:.95rem;margin-top:-5px}#service-scope{scroll-margin-top:100px}</style>
