---
import ActionIcon from '../../components/ActionIcon.astro';
import WorkCarouselControls from '../../components/WorkCarouselControls.astro';
import {site} from '../../data/site';
import {articleLinks} from '../../data/content-links';
import {insights} from '../../data/insights';
const guideFor=(slug:string)=>insights.find(post=>articleLinks[post.slug]?.service===slug);
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingCta from '../../components/BookingCta.astro';
import QuoteGrid from '../../components/QuoteGrid.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import ServiceScope from '../../components/ServiceScope.astro';
import OngoingPlans from '../../components/OngoingPlans.astro';
import OngoingWorkExamples from '../../components/OngoingWorkExamples.astro';
import {services,projects} from '../../data/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
const guide=guideFor(service.slug);
const related=service.projectSlugs.map(slug=>projects.find(p=>p.slug===slug)).filter(Boolean);
---
<BaseLayout title={`${service.name} | Ashbi Design`} description={service.summary} image={service.image}>
<main id="main" data-service-view={service.slug}>
<section class="interior-hero container service-detail-hero"><div><span class="eyebrow">{service.eyebrow}</span><h1>{service.name}.</h1><p>{service.summary}</p><p>{service.fit}</p><div class="service-hero-actions"><a class="button button-lime" href={site.bookingUrl} data-track="booking_calendar_click">Book a call <ActionIcon name="external" /></a><a class="text-link" href={service.slug==='design-and-dev-subscription'?'#ongoing-options':'#service-scope'}>See what’s included <ActionIcon name="forward" /></a></div></div><figure class="service-hero-media"><img src={service.image} alt={service.imageAlt} width="900" height="700" /><figcaption>{service.imageCredit}</figcaption></figure></section>
{service.slug==='design-and-dev-subscription'&&<OngoingPlans compact />}
{service.slug!=='design-and-dev-subscription'&&<section class="section container"><div class="section-heading"><span class="eyebrow">WHAT THIS WORK CAN DO</span><h2>{service.slug==='branding'?'A brand your team can use.':service.slug==='web-design'?'Make the next step easier.':'Make every variant easy to recognise.'}</h2><p>We tailor the work to your customers, existing materials and project goals.</p></div><div class="service-benefits">{service.benefits.map((benefit,i)=><article class="benefit-panel reveal"><span class="benefit-number">0{i+1}</span><h3>{benefit.title}</h3><p>{benefit.copy}</p></article>)}<div class="benefit-photo reveal"><img src={related[0]?.detail||service.image} alt={related[0]?.gallery.find(image=>image.src===related[0]?.detail)?.alt||service.imageAlt} loading="lazy" width="1000" height="750" /></div></div></section>}
<section class="section container deliverables-section" id="service-scope"><div class="section-heading"><span class="eyebrow">WHAT THE PROJECT CAN INCLUDE</span><h2>What we can create for you.</h2><p>We agree the pieces your project needs before work begins.</p></div><div class="deliverables-grid">{service.deliverables.map((item,i)=><article class="deliverable reveal"><span>0{i+1} /</span><h3>{item.title}</h3><p>{item.copy}</p></article>)}</div></section>
{service.slug!=='design-and-dev-subscription'&&<ServiceScope service={service} />}
{service.slug==='design-and-dev-subscription'?<OngoingWorkExamples />:<section class="section container"><div class="section-heading"><span class="eyebrow">RELATED WORK</span><h2>See it in practice.</h2></div><div class="project-grid service-projects" id="related-work-carousel" data-work-carousel aria-label="Related projects" tabindex="0">{related.map(p=>p&&<a class="project-tile" href={`/work/${p.slug}/`}><img class:list={{'image-contain-marin':p.slug==='marin-food','image-contain-bpm':p.slug==='bpm'}} src={p.cardImage||p.image} style={`object-position:${p.cardImagePosition||'center'}`} alt="" loading="lazy" width="800" height="560" /><span>{p.categories.join(' · ')}</span><h3>{p.name} <ActionIcon name="forward" /></h3></a>)}</div><WorkCarouselControls target="related-work-carousel" /></section>}
<section class="section process-section"><div class="container"><div class="section-heading"><span class="eyebrow">HOW WE GET THERE</span><h2>From the brief to launch.</h2></div><ProcessSteps /></div></section>
<section class="section container" aria-label="Client feedback"><QuoteGrid ids={[service.testimonialId]} /></section>
<section class="section faq-section container"><div class="faq-intro"><span class="eyebrow">BEFORE WE BEGIN</span><h2>Your questions, answered.</h2>{guide&&<a class="text-link" href={`/${guide.slug}/`}>{guide.title} <ActionIcon name="forward" /></a>}</div><div class="faq-list">{service.faqs.map(f=><details><summary>{f.q}<ActionIcon name="plus" /></summary><p>{f.a}</p></details>)}</div></section>
<BookingCta service={service.slug} />
</main></BaseLayout>
<style>.section{padding-block:72px}@media(max-width:620px){.section{padding-block:48px}.section-heading{margin-bottom:28px}}.service-hero-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap}.service-hero-actions .text-link{font-size:.72rem}.service-detail-hero>div>p:nth-of-type(2){font-size:.95rem;margin-top:-5px}.service-hero-media{position:relative;min-width:0;margin:0}.service-hero-media figcaption{position:absolute;bottom:16px;left:16px;padding:9px 12px;border-radius:100px;background:#fff;color:var(--ink);font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}#service-scope{scroll-margin-top:100px}</style>
