---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingCta from '../../components/BookingCta.astro';
import {projects} from '../../data/site';
---
<BaseLayout title="Selected Work | Ashbi Design" description="Explore brand identity, packaging, and website projects from Ashbi Design."><main id="main"><section class="interior-hero container"><span class="eyebrow">THE WORK</span><h1>Good ideas deserve <em>to be seen.</em></h1><p>From what people hold in their hands to what they discover online, here is a selection of work from our studio.</p></section><section class="section container"><div class="filter-bar" role="group" aria-label="Filter projects"><button type="button" class="is-active" data-filter="All" aria-pressed="true">All work</button><button type="button" data-filter="Branding" aria-pressed="false">Branding</button><button type="button" data-filter="Websites" aria-pressed="false">Websites</button><button type="button" data-filter="Packaging" aria-pressed="false">Packaging</button></div><div class="project-grid" data-project-grid>{projects.map(p=><a class="project-tile reveal" href={`/work/${p.slug}/`} data-category={p.categories.join("|")} data-services={p.services.join(' ')}><div><img src={p.image} alt={`${p.name} project`} loading="lazy" width="800" height="560" /></div><span>{p.category} · {p.services.join(' / ')}</span><h2>{p.name} <span aria-hidden="true">↗</span></h2><p>{p.intro}</p></a>)}</div></section><BookingCta /></main></BaseLayout>
