---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingCta from '../../components/BookingCta.astro';
import {commerceProjects} from '../../data/site';
---
<BaseLayout title="Product & Ecommerce Work | Ashbi Design" description="Explore Ashbi’s work for product brands and online stores, from packaging and identity to website design."><main id="main"><section class="interior-hero container"><span class="eyebrow">THE WORK</span><h1>Products with presence. <em>Stores with personality.</em></h1><p>Brand identities, packaging, and digital experiences for product brands and the places people shop them.</p></section><section class="section container"><div class="filter-bar" role="group" aria-label="Filter projects"><button type="button" class="is-active" data-filter="All" aria-pressed="true">All work</button><button type="button" data-filter="Branding" aria-pressed="false">Branding</button><button type="button" data-filter="Websites" aria-pressed="false">Websites</button><button type="button" data-filter="Packaging" aria-pressed="false">Packaging</button></div><div class="project-grid" data-project-grid>{commerceProjects.map(p=><a class="project-tile reveal" href={`/work/${p.slug}/`} data-category={p.categories.join("|")} data-services={p.services.join(' ')}><div><img class:list={{'image-contain-marin':p.slug==='marin-food','image-contain-bpm':p.slug==='bpm'}} src={p.cardImage||p.image} style={`object-position:${p.cardImagePosition||'center'}`} alt={p.cardImageAlt||p.imageAlt||`${p.name} project`} loading="lazy" width="800" height="560" /></div><span>{p.category} · {p.services.join(' / ')}</span><h2>{p.name} <span aria-hidden="true">↗</span></h2><p>{p.intro}</p></a>)}</div></section><BookingCta /></main></BaseLayout>

<style>.interior-hero{padding-block:64px 20px;max-width:1440px}.interior-hero h1{max-width:1000px}.interior-hero+.section{padding-top:28px}.filter-bar{margin-bottom:28px}@media(max-width:620px){.interior-hero{padding-block:30px 10px}.interior-hero h1{font-size:2.6rem}.interior-hero p{font-size:.95rem;margin-bottom:10px}.interior-hero .eyebrow{margin-bottom:16px}.interior-hero+.section{padding-top:20px}.filter-bar{gap:8px;margin-bottom:22px}}</style>
