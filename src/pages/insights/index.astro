---
import ActionIcon from '../../components/ActionIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingCta from '../../components/BookingCta.astro';
import InsightCover from '../../components/InsightCover.astro';
import {buyerArticleSlugs} from '../../data/content-links';
import {insights} from '../../data/insights';
const featured=insights.filter(post=>buyerArticleSlugs.includes(post.slug));
const archive=insights.filter(post=>!buyerArticleSlugs.includes(post.slug));
---
<BaseLayout title="Insights | Ashbi Design" description="Ideas and practical notes on brand identity, illustration, and web design from Ashbi Design."><main id="main"><section class="interior-hero container"><span class="eyebrow">NOTES FROM THE STUDIO</span><h1>A little thinking from the studio.</h1><p>Practical notes for planning your brand, packaging and next website project.</p></section><section class="section container"><div class="insights-grid">{featured.map(post=><a class="insight-card" href={`/${post.slug}/`}><InsightCover title={post.shortTitle||post.title} category={post.category} slug={post.slug} /><small>{post.category} · {post.date}</small><h2>{post.title}</h2><span>Read article <ActionIcon name="forward" /></span></a>)}</div></section><section class="section container"><div class="section-heading"><span class="eyebrow">FROM THE ARCHIVE</span><h2>Studio notes & resources.</h2><p>Earlier articles on design practice, tools and life in the studio.</p></div><ul class="archive-list">{archive.map(post=><li><a href={`/${post.slug}/`}>{post.title} <ActionIcon name="forward" /></a><small>{post.category} · {post.date}</small></li>)}</ul></section><BookingCta /></main></BaseLayout>

<style>.interior-hero{padding-block:64px 24px}.interior-hero+.section{padding-top:28px}.archive-list{list-style:none;padding:0}.archive-list li{padding:20px 0;border-top:1px solid #d5dad4}.archive-list a{display:block;font-size:1.15rem;font-weight:600}.archive-list small{display:block;margin-top:8px;color:var(--muted)}@media(max-width:620px){.interior-hero{padding-block:38px 20px}.section{padding-block:38px}}</style>
<style>
.section{padding-block:56px}
.insights-grid{align-items:stretch;gap:36px 24px}
.insight-card{display:flex;flex-direction:column;min-width:0;height:100%}
.insight-card h2{font-size:1.35rem;line-height:1.25;margin:12px 0 22px}
.insight-card>span{margin-top:auto;padding-top:6px}
@media(min-width:761px) and (max-width:1050px){.insights-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
