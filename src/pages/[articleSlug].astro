---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCta from '../components/BookingCta.astro';
import {articleLinks} from '../data/content-links';
import {projects,services} from '../data/site';
import {insights} from '../data/insights';
export function getStaticPaths(){return insights.map(post=>({params:{articleSlug:post.slug},props:{post}}));}
const {post}=Astro.props;
const link=articleLinks[post.slug];
const relatedProject=link&&projects.find(p=>p.slug===link.project);
const relatedService=link&&services.find(s=>s.slug===link.service);
---
<BaseLayout title={`${post.title} | Ashbi Design`} description={post.summary}><main id="main"><article><header class="interior-hero container article-hero"><span class="eyebrow">{post.category.toUpperCase()} / FROM THE STUDIO</span><h1>{post.title}</h1><p>{post.summary}</p><small>ASHBI DESIGN · {post.date}{'updatedAt' in post&&` · Updated ${post.updatedAt}`}</small></header><div class="article-body container" set:html={post.body} /></article>{link&&relatedProject&&relatedService&&<section class="section container article-next"><span class="eyebrow">PUT IT INTO PRACTICE</span><h2>{link.label}</h2><p>{relatedProject.intro}</p><div class="article-next-links"><a class="text-link" href={`/work/${relatedProject.slug}/`}>Explore {relatedProject.name} ↗</a><a class="text-link" href={`/services/${relatedService.slug}/`}>{relatedService.name} ↗</a>{link.campaign&&<a class="text-link" href={`/campaigns/${link.campaign}/`}>Discuss a project like this ↗</a>}</div></section>}<section class="section container"><a class="text-link" href="/insights/">← All insights</a></section><BookingCta /></main></BaseLayout>

<style>
  .article-next-links{display:flex;flex-wrap:wrap;gap:24px}
  .article-hero, .article-body { min-width: 0; overflow-wrap: anywhere; }
  .article-body :global(a) { overflow-wrap: anywhere; }
</style>
