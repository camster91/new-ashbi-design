---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingCta from '../components/BookingCta.astro';
import {insights} from '../data/insights';
export function getStaticPaths(){return insights.map(post=>({params:{articleSlug:post.slug},props:{post}}));}
const {post}=Astro.props;
---
<BaseLayout title={`${post.title} | Ashbi Design`} description={post.summary}><main id="main"><article><header class="interior-hero container article-hero"><span class="eyebrow">{post.category.toUpperCase()} / FROM THE STUDIO</span><h1>{post.title}</h1><p>{post.summary}</p><small>ASHBI DESIGN · {post.date}</small></header><div class="article-body container" set:html={post.body} /></article><section class="section container"><a class="text-link" href="/insights/">← All insights</a></section><BookingCta /></main></BaseLayout>
