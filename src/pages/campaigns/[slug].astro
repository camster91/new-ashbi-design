---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {campaigns,offers} from '../../data/offers';
import {projects,services,testimonials} from '../../data/site';
export function getStaticPaths(){return campaigns.map(campaign=>({params:{slug:campaign.slug},props:{campaign}}));}
const {campaign}=Astro.props;
const service=services.find(item=>item.slug===campaign.serviceSlug)!;
const offer=offers.find(item=>item.serviceSlug===campaign.serviceSlug)!;
const project=projects.find(item=>item.slug===campaign.projectSlug)!;
const quote=testimonials.find(item=>item.id===service.testimonialId)!;
const brief=`/contact/?service=${service.slug}#project-brief`;
---
<BaseLayout title={`${campaign.title} ${campaign.highlight} | Ashbi Design`} description={campaign.intro} image={project.image} noindex={true}>
<main id="main" data-campaign-view={campaign.slug}>
  <section class="campaign-hero container" aria-labelledby="campaign-title"><div class="campaign-hero-copy"><span class="eyebrow">{campaign.eyebrow}</span><h1 id="campaign-title">{campaign.title} <em>{campaign.highlight}</em></h1><p>{campaign.intro}</p><div class="campaign-actions"><a class="button button-lime" href="/contact/" data-track="booking_click">Book a call ↗</a><a class="button button-outline" href={brief}>Send a project brief ↗</a></div><span class="campaign-reassurance">A first conversation about your goals, scope, and next step.</span></div><div class="campaign-hero-image"><img src={project.image} alt={`${project.name} work by Ashbi`} width="900" height="700" fetchpriority="high" /><span>{project.name} / ASHBI WORK</span></div></section>
  <section class="campaign-intro section container" aria-labelledby="campaign-question"><div><span class="eyebrow">THE OPPORTUNITY</span><h2 id="campaign-question">{campaign.question}</h2></div><p>{campaign.answer}</p></section>
  <section class="campaign-includes section" aria-labelledby="campaign-includes-heading"><div class="container"><div class="section-heading"><span class="eyebrow">WHAT WE CAN SHAPE</span><h2 id="campaign-includes-heading">The right pieces, <em>working together.</em></h2><p>We agree the exact scope before starting. A project like this may include:</p></div><div class="campaign-includes-grid">{service.deliverables.map((item,index)=><article><span>0{index+1} / 03</span><h3>{item.title}</h3><p>{item.copy}</p></article>)}</div><p class="campaign-scope">{offer.fit} Timing and budget depend on the deliverables and review stages we agree together.</p></div></section>
  <section class="campaign-project section container" aria-labelledby="campaign-project-heading"><div class="campaign-project-image"><img src={project.detail} alt={`${project.name} project detail by Ashbi`} loading="lazy" width="1000" height="750" /></div><div><span class="eyebrow">A PROJECT TO EXPLORE</span><h2 id="campaign-project-heading">Meet <em>{project.name}.</em></h2><p>{campaign.projectNote}</p><a class="text-link" href={`/work/${project.slug}/`}>See the project <span aria-hidden="true">↗</span></a></div></section>
  <section class="campaign-process section container" aria-labelledby="campaign-process-heading"><div class="section-heading"><span class="eyebrow">HOW WE GET STARTED</span><h2 id="campaign-process-heading">A clear way <em>forward.</em></h2></div><ol>{campaign.steps.map((step,index)=><li><span>0{index+1}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol></section>
  <section class="campaign-proof container" aria-label="Client feedback"><span aria-hidden="true">“</span><blockquote><p>“{quote.quote}”</p><footer><strong>{quote.person}</strong> · {quote.client}</footer></blockquote></section>
  <section class="campaign-faq section container" aria-labelledby="campaign-faq-heading"><div><span class="eyebrow">GOOD TO KNOW</span><h2 id="campaign-faq-heading">A few things <em>you may be wondering.</em></h2></div><div>{campaign.faqs.map(item=><details><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></section>
  <section class="campaign-close container" aria-labelledby="campaign-close-heading"><span class="eyebrow">LET’S TALK ABOUT YOUR PROJECT</span><h2 id="campaign-close-heading">Ready to make <em>your next move?</em></h2><p>Tell Bianca and Cameron what you’re building. We’ll discuss the right next step together.</p><div class="campaign-actions"><a class="button button-lime" href="/contact/" data-track="booking_click">Book a call ↗</a><a class="button button-outline" href={brief}>Send a project brief ↗</a></div><a class="campaign-email" href="mailto:hello@ashbi.ca">Or email hello@ashbi.ca</a></section>
</main>
</BaseLayout>
<style>
  .campaign-hero{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(30px,5vw,75px);align-items:center;padding-block:clamp(60px,8vw,120px)}
  .campaign-hero h1{font-size:clamp(3.3rem,5.6vw,6.8rem);max-width:820px}.campaign-hero-copy>p{font-size:1.16rem;color:var(--muted);max-width:650px}
  .campaign-actions{display:flex;gap:12px;flex-wrap:wrap;margin:25px 0 18px}.campaign-actions .button-outline{border-color:#8490a0}
  .campaign-reassurance{display:block;font-size:.75rem;color:#627078}.campaign-hero-image{position:relative;min-width:0}
  .campaign-hero-image img{width:100%;height:clamp(380px,42vw,600px);object-fit:cover;border-radius:24px}
  .campaign-hero-image span{position:absolute;bottom:18px;left:18px;padding:10px 14px;border-radius:100px;background:#fff;font-size:.65rem;font-weight:800;letter-spacing:.1em}
  .campaign-intro{display:grid;grid-template-columns:1fr .65fr;gap:clamp(30px,7vw,100px);align-items:end;border-top:1px solid var(--line)}.campaign-intro h2{max-width:750px}.campaign-intro>p{font-size:1.14rem;color:var(--muted);margin:0 0 10px}
  .campaign-includes{background:#eef2f2}.campaign-includes-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.campaign-includes-grid article{background:#fff;border:1px solid #dce1e0;border-radius:22px;padding:28px;min-height:290px}.campaign-includes-grid article:nth-child(2){background:#e7f0b9}.campaign-includes-grid article span{font-size:.7rem;letter-spacing:.1em;font-weight:800}.campaign-includes-grid h3{margin-top:65px;font-size:clamp(1.6rem,2.1vw,2.3rem)}.campaign-includes-grid p{font-size:.91rem;color:#5d6668}.campaign-scope{color:#59656a;margin:24px 0 0;font-size:.84rem}
  .campaign-project{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(30px,6vw,90px);align-items:center}.campaign-project-image{border-radius:24px;overflow:hidden}.campaign-project-image img{width:100%;height:clamp(340px,39vw,600px);object-fit:cover}.campaign-project p{font-size:1.08rem;color:var(--muted);max-width:500px}
  .campaign-process ol{padding:0;margin:0;list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line)}.campaign-process li{padding:30px 28px 10px;border-right:1px solid var(--line)}.campaign-process li:first-child{padding-left:0}.campaign-process li:last-child{border:0}.campaign-process li>span{font-size:.75rem;font-weight:800}.campaign-process h3{margin:50px 0 15px}.campaign-process li p{color:var(--muted);font-size:.9rem}
  .campaign-proof{display:flex;gap:30px;align-items:start;padding:35px 45px;background:#e8ebf5;border-radius:24px}.campaign-proof>span{font-size:5rem;line-height:1}.campaign-proof blockquote{margin:0}.campaign-proof p{font-size:clamp(1.3rem,2vw,2rem);line-height:1.4;max-width:900px}.campaign-proof footer{font-size:.79rem;color:#596275}
  .campaign-faq{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(30px,6vw,90px)}.campaign-faq details{border-top:1px solid var(--line);padding:20px 0}.campaign-faq details:last-child{border-bottom:1px solid var(--line)}.campaign-faq summary{display:flex;justify-content:space-between;gap:18px;cursor:pointer;font-weight:700;list-style:none}.campaign-faq summary::-webkit-details-marker{display:none}.campaign-faq details[open] summary span{transform:rotate(45deg)}.campaign-faq details p{color:var(--muted);max-width:700px;margin:16px 0 0}
  .campaign-close{background:radial-gradient(circle at 75% 60%,#5e6fab,#303b72 55%,#242743 100%);border-radius:26px;color:#fff;padding:clamp(36px,6vw,80px);margin-bottom:70px}.campaign-close h2{max-width:850px}.campaign-close em{color:var(--lime)}.campaign-close>p{max-width:650px}.campaign-close .button-outline{border-color:#fff}.campaign-email{font-size:.78rem;text-decoration:underline;text-underline-offset:4px}
  @media(max-width:900px){.campaign-hero,.campaign-intro,.campaign-project,.campaign-faq{grid-template-columns:1fr}.campaign-hero-image img{height:430px}.campaign-includes-grid,.campaign-process ol{grid-template-columns:1fr 1fr}.campaign-process li:nth-child(2){border-right:0}}
  @media(max-width:620px){.campaign-hero{padding-block:55px}.campaign-hero h1{font-size:clamp(3rem,11vw,4.5rem)}.campaign-hero-image img{height:340px}.campaign-actions{flex-direction:column;align-items:flex-start}.campaign-includes-grid,.campaign-process ol{grid-template-columns:1fr}.campaign-includes-grid article{min-height:0}.campaign-includes-grid h3{margin-top:35px}.campaign-process li{padding:25px 0;border-right:0;border-bottom:1px solid var(--line)}.campaign-process h3{margin-top:25px}.campaign-proof{padding:25px;gap:8px}.campaign-proof>span{font-size:3rem}.campaign-close{margin-bottom:30px}}
</style>
