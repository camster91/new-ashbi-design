---
import ActionIcon from '../../components/ActionIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {commerceProjects} from '../../data/site';
---
<BaseLayout title="Brand Identity & Packaging Design Portfolio | Ashbi Design" description="Explore selected branding and packaging work by Ashbi Design."><main id="main"><section class="interior-hero container"><span class="eyebrow">BRANDING PROJECTS</span><h1>Brand identity and packaging design portfolio.</h1><p>Identity and packaging work from Ashbi Design.</p></section><section class="section container project-grid">{commerceProjects.filter(p=>p.categories.includes('Branding')||p.categories.includes('Packaging')).map(p=><a class="project-tile" href={`/work/${p.slug}/`}><img src={p.cardImage||p.image} alt="" /><span>{p.category}</span><h2>{p.name} <ActionIcon name="forward" /></h2></a>)}</section></main></BaseLayout>
