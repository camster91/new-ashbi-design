---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {commerceProjects} from '../../data/site';
---
<BaseLayout title="Branding Projects | Ashbi Design" description="Explore selected branding and packaging work by Ashbi Design."><main id="main"><section class="interior-hero container"><span class="eyebrow">BRANDING PROJECTS</span><h1>Brands that feel <em>like themselves.</em></h1><p>Identity and packaging work from Ashbi Design.</p></section><section class="section container project-grid">{commerceProjects.filter(p=>p.categories.includes('Branding')||p.categories.includes('Packaging')).map(p=><a class="project-tile" href={`/work/${p.slug}/`}><img src={p.image} alt="" /><span>{p.category}</span><h2>{p.name} ↗</h2></a>)}</section></main></BaseLayout>
