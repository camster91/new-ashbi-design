---
import ActionIcon from '../components/ActionIcon.astro';
import {site} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Ashbi Design" description="That page could not be found. Explore the work, services, or contact Ashbi Design." noindex><main id="main"><section class="interior-hero container error-hero"><span class="eyebrow">404 / WRONG TURN</span><h1>Let’s find a <em>better path.</em></h1><p>That page has moved or no longer exists. There is plenty more to explore.</p><div class="hero-actions"><a class="button button-lime" href="/work/">See our work <ActionIcon name="forward" /></a><a class="button button-outline" href={site.bookingUrl} data-track="booking_calendar_click">Book a call <ActionIcon name="external" /></a></div></section></main></BaseLayout>
