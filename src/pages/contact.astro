---
import ActionIcon from '../components/ActionIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingPortrait from '../components/BookingPortrait.astro';
import {site,services,faqs,commerceProjects} from '../data/site';
import {validHubBase,HUB_TIMING_OPTIONS,HUB_PRIVACY_VERSION} from '../lib/hub-inquiry';
import {validEndpoint} from '../lib/enquiry';
const hubMode=site.enquiryMode==='hub';
const available=hubMode?validHubBase(site.hubInquiryBase):validEndpoint(site.enquiryEndpoint);
const timingLabels={urgent_30_days:'Within 30 days',one_to_three_months:'In 1–3 months',three_to_six_months:'In 3–6 months',exploring:'Simply exploring'};
const projectLabels=Object.fromEntries(commerceProjects.map(project=>[project.slug,project.name]));
---
<BaseLayout title="Book a Call or Send a Brief | Ashbi Design" description="Discuss your brand, packaging, or website project with the Ashbi team. Book a call or send a short project brief."><main id="main">
<section class="interior-hero container contact-hero contact-conversation"><div><span class="eyebrow">30 MINUTES WITH BIANCA</span><h1>Let’s talk about your project.</h1><p>Bring your idea, your current brand or the thing that needs attention. In 30 minutes, Bianca will talk through what you need and whether Ashbi is the right fit.</p><ul class="call-agenda"><li>Your goals and the people you want to reach</li><li>What you already have, your timing, and your budget</li><li>A practical next step for the work</li></ul><a class="button button-lime" href={site.bookingUrl} target="_blank" rel="noopener" data-track="booking_calendar_click">Book a call <ActionIcon name="external" /></a><p class="contact-alt">Prefer to write? <a href="#project-brief">Prepare a project brief <ActionIcon name="down" /></a></p></div><BookingPortrait /></section>
<section class="section brief-section container" id="project-brief" aria-labelledby="brief-heading"><div class="brief-intro"><span class="eyebrow">A PLACE TO START</span><h2 id="brief-heading">Tell us a little <em>about your project.</em></h2><p>Tell us what you’re working on and where you’d like help. It’s fine if you’re still figuring things out.</p><a class="text-link" href={`mailto:${site.email}`}>{site.email} <ActionIcon name="mail" /></a><p class="brief-note">We’ll use your details to respond to your enquiry. <a href="/privacy/">Privacy policy</a></p></div>
<form class="project-brief" data-enquiry-form data-hub-base={hubMode?site.hubInquiryBase:''} data-mode={hubMode?'hub':'mailgun'} data-endpoint={!hubMode&&available?site.enquiryEndpoint:''} aria-describedby="brief-availability" novalidate>
<p id="brief-availability" class="form-notice">{available?(hubMode?'Checking online enquiry availability… Required fields are marked with an asterisk.':'Required fields are marked with an asterisk.'):'Online submission is unavailable. Fill in your brief, then open it in your email app to review and send.'}</p>
<p data-project-context data-project-labels={JSON.stringify(projectLabels)} hidden></p>
<p data-plan-context hidden></p>
<noscript><p class="form-notice">Please email your project details to <a href="mailto:hello@ashbi.ca">hello@ashbi.ca</a>.</p></noscript>
<div class="spam-trap" aria-hidden="true"><label>Fax number<input name="fax_number" tabindex="-1" autocomplete="off" /></label></div>
<div class="form-fields"><label>Your name *<input name="name" autocomplete="name" required maxlength="100" aria-describedby="error-name" /><span class="field-error" id="error-name"></span></label><label>Email address *<input name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="error-email" /><span class="field-error" id="error-email"></span></label><label class="field-full">What can we help with? *<select name="service" required aria-describedby="error-service"><option value="">Choose a service</option>{services.map(s=><option value={s.slug}>{s.name}</option>)}<option value="not-sure">Not sure yet</option></select><span class="field-error" id="error-service"></span></label><label class="field-full">Tell us about the project *<textarea name="description" rows="5" required maxlength={hubMode?4500:5000} aria-describedby="description-help error-description"></textarea><small id="description-help">What are you working on, and what would you like help with?</small><span class="field-error" id="error-description"></span></label>{hubMode&&<label class="field-full">What would you like to achieve? *<textarea name="requestedOutcome" rows="3" required maxlength="2000" aria-describedby="error-requestedOutcome" /><span class="field-error" id="error-requestedOutcome"></span></label>}<label>Company <span class="optional">(optional)</span><input name="company" autocomplete="organization" maxlength="150" aria-describedby="error-company" /><span class="field-error" id="error-company"></span></label><label>Website <span class="optional">(optional)</span><input name="website" type="text" inputmode="url" autocomplete="url" maxlength="300" aria-describedby="error-website" /><span class="field-error" id="error-website"></span></label><label class="field-full">Timing <span class="optional">(optional)</span>{hubMode?<select name="timing" aria-describedby="error-timing"><option value="">Choose a timing option</option>{HUB_TIMING_OPTIONS.map(value=><option value={value}>{timingLabels[value]}</option>)}</select>:<input name="timing" maxlength="200" placeholder="A target date, or simply exploring" aria-describedby="error-timing" />}<span class="field-error" id="error-timing"></span></label></div>
{hubMode&&<label class="enquiry-consent"><input name="consent" type="checkbox" required aria-describedby="error-consent" /> <span>I agree that Ashbi can store and use these details to review and respond to my enquiry. <a href="/privacy/">Read the privacy notice</a>.<small>Notice version: {HUB_PRIVACY_VERSION}</small><span class="field-error" id="error-consent"></span></span></label>}<div class="form-actions"><button class="button button-lime" type="submit" disabled data-submit><span data-submit-label>{available?'Send project brief':'Online submission unavailable'}</span><ActionIcon name="forward" /></button><button class="text-link email-draft" type="button" data-email-draft disabled>Open brief in email app <ActionIcon name="mail" /></button></div><p class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></p>
</form></section>
<section class="section faq-section container"><div class="faq-intro"><span class="eyebrow">QUESTIONS</span><h2>Good to know <em>before we talk.</em></h2></div><div class="faq-list">{faqs.slice(0,3).map(f=><details><summary>{f.q}<ActionIcon name="plus" /></summary><p>{f.a}</p></details>)}</div></section>
</main></BaseLayout>

<style>
.enquiry-consent{display:flex;align-items:flex-start;gap:12px;margin:20px 0;font-size:14px;line-height:1.6}.enquiry-consent input{width:20px;height:20px;flex:none;margin-top:3px}.enquiry-consent small{display:block;color:var(--muted);font-size:12px}
.contact-conversation{grid-template-columns:1.15fr .85fr;gap:clamp(40px,7vw,110px);padding-block:64px 72px}
.contact-conversation h1{font-size:clamp(3rem,5.5vw,6rem);max-width:800px;margin-bottom:28px}
.call-agenda{padding-left:20px;margin:24px 0 30px;color:var(--muted);line-height:1.7;max-width:600px}.call-agenda li+li{margin-top:8px}
@media(max-width:760px){.contact-conversation{grid-template-columns:1fr;padding-block:42px;gap:28px}.contact-conversation :global(.booking-portrait){max-width:400px}.contact-conversation :global(.booking-portrait img){aspect-ratio:4/3;object-position:center 34%}}
</style>
