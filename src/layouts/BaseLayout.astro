---
import '../styles/fonts.css';
import '../styles/ashbi.css';
import { site } from '../data/site';
import Header from '../components/AshbiHeader.astro';
import Footer from '../components/AshbiFooter.astro';
interface Props { title: string; description: string; image?: string; noindex?: boolean; canonicalPath?: string; }
const { title, description, image = '/images/ashbi/og-default.webp', noindex = false, canonicalPath } = Astro.props;
const canonical = new URL(canonicalPath || Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const schema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: Astro.site?.toString(), logo: new URL('/images/ashbi/logo.png', Astro.site).toString(), email: site.email, address: { '@type': 'PostalAddress', addressLocality: 'Toronto', addressRegion: 'ON', addressCountry: 'CA' } }).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#242743" />
    <meta property="og:site_name" content="Ashbi Design" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/images/ashbi/logo.png" />
    <script type="application/ld+json" set:html={schema} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    <script>
      import '../scripts/ashbi.ts';
    </script>
  </body>
</html>
